<Window x:Class="MiniCapture.HotkeyDetectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MiniCapture.Resources"
        Title="{x:Static res:Strings.Hotkey_DetectSuffix}"
        Width="360"
        Height="216"
        MinWidth="360"
        MinHeight="216"
        MaxWidth="360"
        MaxHeight="216"
        Background="{StaticResource SettingsBackgroundBrush}"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border Padding="18"
            Background="{StaticResource SettingsBackgroundBrush}"
            BorderBrush="{StaticResource SettingsBorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="64" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SettingsTextBrush}" />
            <TextBlock x:Name="InstructionText"
                       Grid.Row="1"
                       Margin="0,10,0,0"
                       FontSize="13"
                       Foreground="{StaticResource SettingsMutedTextBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="CountdownText"
                       Grid.Row="2"
                       Margin="0,8,0,0"
                       VerticalAlignment="Center"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SettingsHighlightTextBrush}"
                       TextAlignment="Center" />
            <Button Grid.Row="3"
                    Width="88"
                    HorizontalAlignment="Right"
                    Click="OnCancelClick"
                    Content="{x:Static res:Strings.Common_Cancel}"
                    Padding="12,7"
                    Background="{StaticResource SettingsButtonBrush}"
                    BorderBrush="{StaticResource SettingsButtonBorderBrush}"
                    BorderThickness="1"
                    Foreground="{StaticResource SettingsTextBrush}" />
        </Grid>
    </Border>
</Window>
