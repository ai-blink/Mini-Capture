<Window x:Class="MiniCapture.HotkeyDetectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="키 감지"
        Width="360"
        Height="216"
        MinWidth="360"
        MinHeight="216"
        MaxWidth="360"
        MaxHeight="216"
        Background="#121414"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border Padding="18"
            Background="#121414"
            BorderBrush="#31383E"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="64" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#E6E8EA" />
            <TextBlock x:Name="InstructionText"
                       Grid.Row="1"
                       Margin="0,10,0,0"
                       FontSize="13"
                       Foreground="#A8B0B8"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="CountdownText"
                       Grid.Row="2"
                       Margin="0,8,0,0"
                       VerticalAlignment="Center"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#5EEAD4"
                       TextAlignment="Center" />
            <Button Grid.Row="3"
                    Width="88"
                    HorizontalAlignment="Right"
                    Click="OnCancelClick"
                    Content="취소"
                    Padding="12,7"
                    Background="#25303A"
                    BorderBrush="#425160"
                    BorderThickness="1"
                    Foreground="#E6E8EA" />
        </Grid>
    </Border>
</Window>
