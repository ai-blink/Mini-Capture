<Window x:Class="MiniCapture.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Capture 설정"
        Width="780"
        Height="520"
        MinWidth="720"
        MinHeight="460"
        Background="#121414"
        FontFamily="Segoe UI"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded">
    <Window.Resources>
        <SolidColorBrush x:Key="SettingsBackgroundBrush" Color="#121414" />
        <SolidColorBrush x:Key="SettingsPanelBrush" Color="#181B1C" />
        <SolidColorBrush x:Key="SettingsPanelAltBrush" Color="#1F2427" />
        <SolidColorBrush x:Key="SettingsBorderBrush" Color="#31383E" />
        <SolidColorBrush x:Key="SettingsAccentBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="SettingsTextBrush" Color="#E6E8EA" />
        <SolidColorBrush x:Key="SettingsMutedTextBrush" Color="#A8B0B8" />

        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="#25303A" />
            <Setter Property="BorderBrush" Value="#425160" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SettingsNavItemStyle" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{StaticResource SettingsMutedTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#17324A" />
                    <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource SettingsBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="22,0"
                Background="#16191A"
                BorderBrush="{StaticResource SettingsBorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button AutomationProperties.AutomationId="SettingsCloseButton"
                        Click="OnCloseClick"
                        Content="닫기"
                        DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Style="{StaticResource SettingsButtonStyle}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsTextBrush}"
                               Text="Mini Capture 설정" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SettingsMutedTextBrush}"
                               Text="확장자 연결과 앱 세부 설정" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SettingsPanelBrush}"
                    BorderBrush="{StaticResource SettingsBorderBrush}"
                    BorderThickness="0,0,1,0">
                <ListBox x:Name="SectionList"
                         AutomationProperties.AutomationId="SettingsSectionList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource SettingsTextBrush}"
                         ItemContainerStyle="{StaticResource SettingsNavItemStyle}"
                         SelectionChanged="OnSectionSelectionChanged"
                         SelectedIndex="0">
                    <ListBoxItem AutomationProperties.AutomationId="ExtensionSettingsSection"
                                 Tag="ExtensionDefaults">
                        <TextBlock Text="확장자 연결" />
                    </ListBoxItem>
                </ListBox>
            </Border>

            <Grid Grid.Column="1"
                  Margin="22">
                <Grid x:Name="ExtensionDefaultsPanel"
                      AutomationProperties.AutomationId="ExtensionDefaultsPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SettingsTextBrush}"
                                   Text="확장자 연결" />
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource SettingsMutedTextBrush}"
                                   Text="PNG, JPG, JPEG 파일을 Mini Capture Viewer로 열기" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,18,0,16"
                            Padding="14"
                            Background="{StaticResource SettingsPanelAltBrush}"
                            BorderBrush="{StaticResource SettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="148" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Foreground="{StaticResource SettingsTextBrush}"
                                       Text=".png" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Foreground="{StaticResource SettingsMutedTextBrush}"
                                       Text="Portable Network Graphics" />
                            <TextBlock Grid.Row="0"
                                       Grid.Column="2"
                                       Foreground="#5EEAD4"
                                       Text="파일 인자 지원" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,12,0,0"
                                       Foreground="{StaticResource SettingsTextBrush}"
                                       Text=".jpg" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Margin="0,12,0,0"
                                       Foreground="{StaticResource SettingsMutedTextBrush}"
                                       Text="JPEG Image" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Margin="0,12,0,0"
                                       Foreground="#5EEAD4"
                                       Text="파일 인자 지원" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Margin="0,12,0,0"
                                       Foreground="{StaticResource SettingsTextBrush}"
                                       Text=".jpeg" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Margin="0,12,0,0"
                                       Foreground="{StaticResource SettingsMutedTextBrush}"
                                       Text="JPEG Image" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Margin="0,12,0,0"
                                       Foreground="#5EEAD4"
                                       Text="파일 인자 지원" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Orientation="Horizontal">
                            <Button AutomationProperties.AutomationId="OpenWindowsDefaultAppsButton"
                                    Click="OnOpenDefaultAppsClick"
                                    Content="Windows 기본 앱 열기"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource SettingsButtonStyle}" />
                            <Button AutomationProperties.AutomationId="CopyExecutablePathButton"
                                    Click="OnCopyExecutablePathClick"
                                    Content="실행 파일 경로 복사"
                                    Style="{StaticResource SettingsButtonStyle}" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Margin="0,18,0,0"
                                Padding="12,9"
                                Background="#101213"
                                BorderBrush="{StaticResource SettingsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock x:Name="ExecutablePathText"
                                       AutomationProperties.AutomationId="SettingsExecutablePathText"
                                       FontSize="12"
                                       Foreground="{StaticResource SettingsMutedTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <TextBlock Grid.Row="2"
                                   x:Name="SettingsStatusText"
                                   AutomationProperties.AutomationId="SettingsStatusText"
                                   Margin="0,16,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource SettingsMutedTextBrush}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="18,0"
                Background="#101213"
                BorderBrush="{StaticResource SettingsBorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource SettingsMutedTextBrush}"
                       Text="기본 앱 선택은 Windows가 관리합니다." />
        </Border>
    </Grid>
</Window>
