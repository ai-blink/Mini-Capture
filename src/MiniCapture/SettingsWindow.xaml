<Window x:Class="MiniCapture.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Capture 설정"
        Width="936"
        Height="837"
        MinWidth="864"
        MinHeight="756"
        Background="#121414"
        FontFamily="Segoe UI"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="SettingsBackgroundBrush" Color="#121414" />
        <SolidColorBrush x:Key="SettingsPanelBrush" Color="#181B1C" />
        <SolidColorBrush x:Key="SettingsPanelAltBrush" Color="#1F2427" />
        <SolidColorBrush x:Key="SettingsBorderBrush" Color="#31383E" />
        <SolidColorBrush x:Key="SettingsAccentBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="SettingsTextBrush" Color="#E6E8EA" />
        <SolidColorBrush x:Key="SettingsMutedTextBrush" Color="#A8B0B8" />

        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="#25303A" />
            <Setter Property="BorderBrush" Value="#425160" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#111516" />
            <Setter Property="Foreground" Value="#708090" />
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
        </Style>

        <Style TargetType="Thumb">
            <Setter Property="Background" Value="#526170" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Margin="3,2"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExtensionCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="SettingsNavItemStyle" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{StaticResource SettingsMutedTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#17324A" />
                    <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource SettingsBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="22,0"
                Background="#16191A"
                BorderBrush="{StaticResource SettingsBorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button AutomationProperties.AutomationId="SettingsCloseButton"
                        Click="OnCloseClick"
                        Content="닫기"
                        DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Style="{StaticResource SettingsButtonStyle}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsTextBrush}"
                               Text="Mini Capture 설정" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SettingsMutedTextBrush}"
                               Text="확장자 연결과 앱 세부 설정" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SettingsPanelBrush}"
                    BorderBrush="{StaticResource SettingsBorderBrush}"
                    BorderThickness="0,0,1,0">
                <ListBox x:Name="SectionList"
                         AutomationProperties.AutomationId="SettingsSectionList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource SettingsTextBrush}"
                         ItemContainerStyle="{StaticResource SettingsNavItemStyle}"
                         SelectionChanged="OnSectionSelectionChanged"
                         SelectedIndex="0">
                    <ListBoxItem AutomationProperties.AutomationId="ExtensionSettingsSection"
                                 Tag="ExtensionDefaults">
                        <TextBlock Text="확장자 연결" />
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.AutomationId="CaptureSettingsSection"
                                 Tag="CaptureSettings">
                        <TextBlock Text="캡처 설정" />
                    </ListBoxItem>
                </ListBox>
            </Border>

            <Grid Grid.Column="1"
                  Margin="22">
                <ScrollViewer x:Name="CaptureSettingsPanel"
                              AutomationProperties.AutomationId="CaptureSettingsPanel"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SettingsTextBrush}"
                                   Text="캡처 설정" />
                        <TextBlock Margin="0,5,0,18"
                                   FontSize="12"
                                   Foreground="{StaticResource SettingsMutedTextBrush}"
                                   Text="단축키, 타이머, 투명 퀵 아이콘 표시 상태를 저장합니다." />

                        <Border Padding="14"
                                Background="{StaticResource SettingsPanelBrush}"
                                BorderBrush="{StaticResource SettingsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding HotkeyGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Margin="0,0,14,0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource SettingsTextBrush}"
                                                           Text="{Binding Label}" />

                                                <ItemsControl Grid.Column="1"
                                                              ItemsSource="{Binding Slots}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="3" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,8,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="54" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <ComboBox Grid.Column="0"
                                                                          MinHeight="32"
                                                                          AutomationProperties.AutomationId="{Binding FirstKeyAutomationId}"
                                                                          AutomationProperties.Name="{Binding FirstKeyAutomationName}"
                                                                          ItemsSource="{Binding ModifierOptions}"
                                                                          SelectedItem="{Binding FirstKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          ToolTip="{Binding StatusText}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Margin="4,0"
                                                                           VerticalAlignment="Center"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource SettingsMutedTextBrush}"
                                                                           Text="+" />
                                                                <ComboBox Grid.Column="2"
                                                                          MinHeight="32"
                                                                          AutomationProperties.AutomationId="{Binding SecondKeyAutomationId}"
                                                                          AutomationProperties.Name="{Binding SecondKeyAutomationName}"
                                                                          ItemsSource="{Binding ModifierOptions}"
                                                                          SelectedItem="{Binding SecondKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          ToolTip="{Binding StatusText}" />
                                                                <TextBlock Grid.Column="3"
                                                                           Margin="4,0"
                                                                           VerticalAlignment="Center"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource SettingsMutedTextBrush}"
                                                                           Text="+" />
                                                                <ComboBox Grid.Column="4"
                                                                          MinHeight="32"
                                                                          Margin="0,0,6,0"
                                                                          AutomationProperties.AutomationId="{Binding MainKeyAutomationId}"
                                                                          AutomationProperties.Name="{Binding MainKeyAutomationName}"
                                                                          IsEditable="True"
                                                                          ItemsSource="{Binding MainKeyOptions}"
                                                                          Text="{Binding MainKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          ToolTip="{Binding StatusText}" />
                                                                <Button Grid.Column="5"
                                                                        Width="48"
                                                                        MinWidth="48"
                                                                        Padding="0"
                                                                        AutomationProperties.AutomationId="{Binding DetectAutomationId}"
                                                                        AutomationProperties.Name="{Binding DetectAutomationName}"
                                                                        Click="OnDetectHotkeyClick"
                                                                        Content="감지"
                                                                        Style="{StaticResource SettingsButtonStyle}"
                                                                        Tag="{Binding}"
                                                                        ToolTip="{Binding SlotLabel}" />

                                                                <TextBlock Grid.Column="6"
                                                                           Margin="8,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="18"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource SettingsMutedTextBrush}"
                                                                           Text="{Binding PlusText}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Margin="0,8,0,0"
                                           FontSize="12"
                                           Foreground="{StaticResource SettingsMutedTextBrush}"
                                           Text="키 감지를 누른 뒤 5초 안에 Ctrl/Alt/Shift와 함께 원하는 키를 누르세요." />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="14"
                                Background="{StaticResource SettingsPanelBrush}"
                                BorderBrush="{StaticResource SettingsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="158" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Margin="0,0,12,10"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SettingsMutedTextBrush}"
                                           Text="타이머 시간(초)" />
                                <TextBox x:Name="TimerDelayBox"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="0,0,0,10"
                                         AutomationProperties.AutomationId="TimerDelaySecondsBox"
                                         MinHeight="32" />

                                <CheckBox x:Name="QuickButtonVisibleCheck"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          AutomationProperties.AutomationId="QuickButtonVisibleCheck"
                                          Content="투명 퀵 아이콘을 바탕화면에 표시"
                                          Foreground="{StaticResource SettingsTextBrush}" />
                            </Grid>
                        </Border>

                        <WrapPanel Margin="0,14,0,0">
                            <Button AutomationProperties.AutomationId="SaveCaptureSettingsButton"
                                    Click="OnSaveCaptureSettingsClick"
                                    Content="저장"
                                    Margin="0,0,10,10"
                                    MinWidth="96"
                                    Style="{StaticResource SettingsButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ResetCaptureSettingsButton"
                                    Click="OnResetCaptureSettingsClick"
                                    Content="기본값"
                                    Margin="0,0,10,10"
                                    MinWidth="96"
                                    Style="{StaticResource SettingsButtonStyle}" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="ExtensionDefaultsPanel"
                      AutomationProperties.AutomationId="ExtensionDefaultsPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SettingsTextBrush}"
                                   Text="확장자 연결" />
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource SettingsMutedTextBrush}"
                                   Text="이미지 파일을 Mini Capture Viewer로 열기 위한 현재 상태 확인과 Windows 기본 앱 연결 안내" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Margin="0,18,0,12"
                            Padding="14,12"
                            Background="{StaticResource SettingsPanelAltBrush}"
                            BorderBrush="{StaticResource SettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SettingsTextBrush}"
                                       Text="연결 상태" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,6,20,0"
                                       FontSize="12"
                                       Foreground="{StaticResource SettingsMutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="왼쪽 체크는 현재 Windows 연결 상태 표시, 오른쪽 체크는 Windows 기본 앱 화면에서 바꿀 후보 선택입니다. 앱은 기본 연결을 직접 강제 변경하지 않습니다." />
                            <TextBlock Grid.Row="0"
                                       Grid.RowSpan="2"
                                       Grid.Column="1"
                                       x:Name="AssociationSummaryText"
                                       AutomationProperties.AutomationId="AssociationSummaryText"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#5EEAD4"
                                       Text="확인 대기" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ExtensionGroupsList"
                                          AutomationProperties.AutomationId="ExtensionGroupsList"
                                          ItemsSource="{Binding ExtensionGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12"
                                                Padding="14"
                                                Background="{StaticResource SettingsPanelBrush}"
                                                BorderBrush="{StaticResource SettingsBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <StackPanel>
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Left"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource SettingsTextBrush}"
                                                               Text="{Binding Name}" />
                                                    <TextBlock Margin="10,2,0,0"
                                                               FontSize="12"
                                                               Foreground="{StaticResource SettingsMutedTextBrush}"
                                                               Text="{Binding Description}" />
                                                </DockPanel>

                                                <Grid Margin="0,12,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="86" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="108" />
                                                        <ColumnDefinition Width="108" />
                                                        <ColumnDefinition Width="140" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="11" Foreground="{StaticResource SettingsMutedTextBrush}" Text="확장자" />
                                                    <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource SettingsMutedTextBrush}" Text="형식" />
                                                    <TextBlock Grid.Column="2" FontSize="11" Foreground="{StaticResource SettingsMutedTextBrush}" Text="현재 연결" />
                                                    <TextBlock Grid.Column="3" FontSize="11" Foreground="{StaticResource SettingsMutedTextBrush}" Text="요청 선택" />
                                                    <TextBlock Grid.Column="4" FontSize="11" Foreground="{StaticResource SettingsMutedTextBrush}" Text="Windows 상태" />
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Extensions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid MinHeight="34">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="86" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="108" />
                                                                    <ColumnDefinition Width="108" />
                                                                    <ColumnDefinition Width="140" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           VerticalAlignment="Center"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource SettingsTextBrush}"
                                                                           Text="{Binding Extension}" />
                                                                <TextBlock Grid.Column="1"
                                                                           Margin="0,0,12,0"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource SettingsMutedTextBrush}"
                                                                           Text="{Binding DisplayName}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <CheckBox Grid.Column="2"
                                                                          AutomationProperties.Name="{Binding CurrentStateAutomationName}"
                                                                          IsChecked="{Binding IsAssociated, Mode=OneWay}"
                                                                          IsEnabled="False"
                                                                          Style="{StaticResource ExtensionCheckBoxStyle}" />
                                                                <CheckBox Grid.Column="3"
                                                                          AutomationProperties.Name="{Binding CandidateAutomationName}"
                                                                          IsChecked="{Binding IsSelected}"
                                                                          Style="{StaticResource ExtensionCheckBoxStyle}" />
                                                                <TextBlock Grid.Column="4"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="12"
                                                                           Foreground="{Binding StatusBrush}"
                                                                           Text="{Binding StatusText}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding StatusDetail}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="1"
                                Margin="0,6,0,0"
                                Padding="10,10,10,0"
                                Background="{StaticResource SettingsBackgroundBrush}"
                                BorderBrush="{StaticResource SettingsBorderBrush}"
                                BorderThickness="0,1,0,0">
                            <WrapPanel>
                                <Button AutomationProperties.AutomationId="SelectAllExtensionCandidatesButton"
                                        Click="OnSelectAllClick"
                                        Content="전체 선택"
                                        Margin="0,0,10,10"
                                        MinWidth="96"
                                        Style="{StaticResource SettingsButtonStyle}" />
                                <Button AutomationProperties.AutomationId="ClearExtensionCandidatesButton"
                                        Click="OnClearSelectionClick"
                                        Content="선택 안 함"
                                        Margin="0,0,10,10"
                                        MinWidth="106"
                                        Style="{StaticResource SettingsButtonStyle}" />
                                <Button AutomationProperties.AutomationId="RefreshExtensionAssociationsButton"
                                        Click="OnRefreshAssociationsClick"
                                        Content="새로고침"
                                        Margin="0,0,10,10"
                                        MinWidth="96"
                                        Style="{StaticResource SettingsButtonStyle}" />
                                <Button AutomationProperties.AutomationId="OpenWindowsDefaultAppsButton"
                                        Click="OnOpenDefaultAppsClick"
                                        Content="Windows 기본 앱 열기"
                                        Margin="0,0,10,10"
                                        MinWidth="178"
                                        Style="{StaticResource SettingsButtonStyle}" />
                                <Button AutomationProperties.AutomationId="CopyExecutablePathButton"
                                        Click="OnCopyExecutablePathClick"
                                        Content="실행 파일 경로 복사"
                                        Margin="0,0,0,10"
                                        MinWidth="178"
                                        Style="{StaticResource SettingsButtonStyle}" />
                            </WrapPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Margin="0,8,0,0"
                                Padding="12,9"
                                Background="#101213"
                                BorderBrush="{StaticResource SettingsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock x:Name="ExecutablePathText"
                                       AutomationProperties.AutomationId="SettingsExecutablePathText"
                                       FontSize="12"
                                       Foreground="{StaticResource SettingsMutedTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <TextBlock Grid.Row="3"
                                   x:Name="SettingsStatusText"
                                   AutomationProperties.AutomationId="SettingsStatusText"
                                   Margin="0,12,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource SettingsMutedTextBrush}" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="18,0"
                Background="#101213"
                BorderBrush="{StaticResource SettingsBorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource SettingsMutedTextBrush}"
                       Text="기본 앱 선택은 Windows가 관리합니다." />
        </Border>
    </Grid>
</Window>
