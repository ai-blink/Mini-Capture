<Window x:Class="MiniCapture.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MiniCapture.Resources"
        Title="{x:Static res:Strings.Settings_WindowTitle}"
        Icon="Assets/App/MiniCapture.ico"
        Width="730"
        Height="837"
        MinWidth="710"
        MinHeight="756"
        Background="#121414"
        FontFamily="Segoe UI"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        Loaded="OnLoaded">
    <Window.Resources>
        <SolidColorBrush x:Key="SettingsBackgroundBrush" Color="#121414" />
        <SolidColorBrush x:Key="SettingsPanelBrush" Color="#181B1C" />
        <SolidColorBrush x:Key="SettingsPanelAltBrush" Color="#1F2427" />
        <SolidColorBrush x:Key="SettingsBorderBrush" Color="#31383E" />
        <SolidColorBrush x:Key="SettingsAccentBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="SettingsTextBrush" Color="#E6E8EA" />
        <SolidColorBrush x:Key="SettingsMutedTextBrush" Color="#A8B0B8" />

        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="#25303A" />
            <Setter Property="BorderBrush" Value="#425160" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="#F4F7FA" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#101820" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#111516" />
            <Setter Property="Foreground" Value="#708090" />
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
        </Style>

        <Style TargetType="Thumb">
            <Setter Property="Background" Value="#526170" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Margin="3,2"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsNavItemStyle" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{StaticResource SettingsMutedTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#17324A" />
                    <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SettingsAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource SettingsBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18,0"
                Background="#16191A"
                BorderBrush="{StaticResource SettingsBorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button AutomationProperties.AutomationId="SettingsCloseButton"
                        Click="OnCloseClick"
                        Content="{x:Static res:Strings.Common_Close}"
                        DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Style="{StaticResource SettingsButtonStyle}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SettingsTextBrush}"
                               Text="{x:Static res:Strings.Settings_WindowTitle}" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{StaticResource SettingsMutedTextBrush}"
                               Text="{x:Static res:Strings.Settings_HeaderSubtitle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SettingsPanelBrush}"
                    BorderBrush="{StaticResource SettingsBorderBrush}"
                    BorderThickness="0,0,1,0">
                <ListBox x:Name="SectionList"
                         AutomationProperties.AutomationId="SettingsSectionList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource SettingsTextBrush}"
                         ItemContainerStyle="{StaticResource SettingsNavItemStyle}"
                         SelectionChanged="OnSectionSelectionChanged"
                         SelectedIndex="0">
                    <ListBoxItem AutomationProperties.AutomationId="ExtensionSettingsSection"
                                 Tag="ExtensionDefaults">
                        <TextBlock Text="{x:Static res:Strings.Settings_Section_ExtensionDefaults}" />
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.AutomationId="CaptureSettingsSection"
                                 Tag="CaptureSettings">
                        <TextBlock Text="{x:Static res:Strings.Settings_Section_CaptureSettings}" />
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.AutomationId="WindowExclusionsSettingsSection"
                                 Tag="WindowExclusions">
                        <TextBlock Text="{x:Static res:Strings.Settings_Section_WindowExclusions}" />
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.AutomationId="LanguageSettingsSection"
                                 Tag="Language">
                        <TextBlock Text="{x:Static res:Strings.Settings_Section_Language}" />
                    </ListBoxItem>
                </ListBox>
            </Border>

            <Grid Grid.Column="1"
                  Margin="12"
                  MinWidth="0">
                <ScrollViewer x:Name="CaptureSettingsPanel"
                              AutomationProperties.AutomationId="CaptureSettingsPanel"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SettingsTextBrush}"
                                   Text="{x:Static res:Strings.Settings_Section_CaptureSettings}" />
                        <TextBlock Margin="0,5,0,18"
                                   FontSize="12"
                                   Foreground="{StaticResource SettingsMutedTextBrush}"
                                   Text="{x:Static res:Strings.Settings_Capture_Subtitle}" />

                        <Border Padding="14"
                                Background="{StaticResource SettingsPanelBrush}"
                                BorderBrush="{StaticResource SettingsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding HotkeyGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Margin="0,0,10,0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource SettingsTextBrush}"
                                                           Text="{Binding Label}" />

                                                <ItemsControl Grid.Column="1"
                                                              ItemsSource="{Binding Slots}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="1" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0"
                                                                  HorizontalAlignment="Left">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="74" />
                                                                    <ColumnDefinition Width="46" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="74" />
                                                                    <ColumnDefinition Width="46" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="96" />
                                                                    <ColumnDefinition Width="46" />
                                                                </Grid.ColumnDefinitions>

                                                                <ComboBox Grid.Row="0"
                                                                          Grid.Column="0"
                                                                          AutomationProperties.AutomationId="{Binding FirstKeyAutomationId}"
                                                                          AutomationProperties.Name="{Binding FirstKeyAutomationName}"
                                                                          ItemsSource="{Binding ModifierOptions}"
                                                                          SelectedItem="{Binding FirstKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          Style="{StaticResource SettingsComboBoxStyle}"
                                                                          ToolTip="{Binding StatusText}" />
                                                                <Button Grid.Row="0"
                                                                        Grid.Column="1"
                                                                        Width="42"
                                                                        MinWidth="42"
                                                                        Margin="4,0,0,0"
                                                                        Padding="0"
                                                                        AutomationProperties.AutomationId="{Binding DetectFirstKeyAutomationId}"
                                                                        AutomationProperties.Name="{Binding DetectFirstKeyAutomationName}"
                                                                        Click="OnDetectKeyPartClick"
                                                                        Content="{x:Static res:Strings.Common_Detect}"
                                                                        Style="{StaticResource SettingsButtonStyle}"
                                                                        Tag="First"
                                                                        ToolTip="{Binding FirstKeyAutomationName}" />
                                                                <TextBlock Grid.Row="0"
                                                                           Grid.Column="2"
                                                                           Margin="4,0"
                                                                           VerticalAlignment="Center"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource SettingsMutedTextBrush}"
                                                                           Text="+" />
                                                                <ComboBox Grid.Row="0"
                                                                          Grid.Column="3"
                                                                          AutomationProperties.AutomationId="{Binding SecondKeyAutomationId}"
                                                                          AutomationProperties.Name="{Binding SecondKeyAutomationName}"
                                                                          ItemsSource="{Binding ModifierOptions}"
                                                                          SelectedItem="{Binding SecondKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          Style="{StaticResource SettingsComboBoxStyle}"
                                                                          ToolTip="{Binding StatusText}" />
                                                                <Button Grid.Row="0"
                                                                        Grid.Column="4"
                                                                        Width="42"
                                                                        MinWidth="42"
                                                                        Margin="4,0,0,0"
                                                                        Padding="0"
                                                                        AutomationProperties.AutomationId="{Binding DetectSecondKeyAutomationId}"
                                                                        AutomationProperties.Name="{Binding DetectSecondKeyAutomationName}"
                                                                        Click="OnDetectKeyPartClick"
                                                                        Content="{x:Static res:Strings.Common_Detect}"
                                                                        Style="{StaticResource SettingsButtonStyle}"
                                                                        Tag="Second"
                                                                        ToolTip="{Binding SecondKeyAutomationName}" />
                                                                <TextBlock Grid.Row="0"
                                                                           Grid.Column="5"
                                                                           Margin="4,0"
                                                                           VerticalAlignment="Center"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource SettingsMutedTextBrush}"
                                                                           Text="+" />
                                                                <ComboBox Grid.Row="0"
                                                                          Grid.Column="6"
                                                                          AutomationProperties.AutomationId="{Binding MainKeyAutomationId}"
                                                                          AutomationProperties.Name="{Binding MainKeyAutomationName}"
                                                                          IsEditable="True"
                                                                          ItemsSource="{Binding MainKeyOptions}"
                                                                          Style="{StaticResource SettingsComboBoxStyle}"
                                                                          Text="{Binding MainKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          ToolTip="{Binding StatusText}" />
                                                                <Button Grid.Row="0"
                                                                        Grid.Column="7"
                                                                        Width="42"
                                                                        MinWidth="42"
                                                                        Margin="4,0,0,0"
                                                                        Padding="0"
                                                                        AutomationProperties.AutomationId="{Binding DetectMainKeyAutomationId}"
                                                                        AutomationProperties.Name="{Binding DetectMainKeyAutomationName}"
                                                                        Click="OnDetectKeyPartClick"
                                                                        Content="{x:Static res:Strings.Common_Detect}"
                                                                        Style="{StaticResource SettingsButtonStyle}"
                                                                        Tag="Main"
                                                                        ToolTip="{Binding MainKeyAutomationName}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Margin="0,8,0,0"
                                           FontSize="12"
                                           Foreground="{StaticResource SettingsMutedTextBrush}"
                                           Text="{x:Static res:Strings.Settings_Capture_HotkeyHelp}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="14"
                                Background="{StaticResource SettingsPanelBrush}"
                                BorderBrush="{StaticResource SettingsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="144" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Margin="0,0,12,10"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SettingsMutedTextBrush}"
                                           Text="{x:Static res:Strings.Settings_Capture_TimerLabel}" />
                                <ComboBox x:Name="TimerDelayBox"
                                          Grid.Row="0"
                                          Grid.Column="1"
                                          Width="414"
                                          Margin="0,0,0,10"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.AutomationId="TimerDelaySecondsBox"
                                          IsEditable="True"
                                          Style="{StaticResource SettingsComboBoxStyle}">
                                    <ComboBoxItem Content="0" />
                                    <ComboBoxItem Content="3" />
                                    <ComboBoxItem Content="5" />
                                    <ComboBoxItem Content="7" />
                                    <ComboBoxItem Content="10" />
                                </ComboBox>

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Margin="0,0,12,10"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SettingsMutedTextBrush}"
                                           Text="{x:Static res:Strings.Settings_Capture_ShortcutTimerLabel}" />
                                <ComboBox x:Name="ShortcutTimerDelayBox"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          Width="414"
                                          Margin="0,0,0,10"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.AutomationId="ShortcutTimerDelaySecondsBox"
                                          IsEditable="True"
                                          Style="{StaticResource SettingsComboBoxStyle}">
                                    <ComboBoxItem Content="3" />
                                    <ComboBoxItem Content="5" />
                                    <ComboBoxItem Content="7" />
                                    <ComboBoxItem Content="10" />
                                </ComboBox>

                                <CheckBox x:Name="QuickButtonVisibleCheck"
                                          Grid.Row="2"
                                          Grid.Column="1"
                                          AutomationProperties.AutomationId="QuickButtonVisibleCheck"
                                          Content="{x:Static res:Strings.Settings_Capture_QuickButtonVisible}"
                                          Foreground="{StaticResource SettingsTextBrush}" />

                                <CheckBox x:Name="CaptureUiExcludedCheck"
                                          Grid.Row="3"
                                          Grid.Column="1"
                                          Margin="0,10,0,0"
                                          AutomationProperties.AutomationId="CaptureUiExcludedCheck"
                                          Content="{x:Static res:Strings.Settings_Capture_UiExcluded}"
                                          Foreground="{StaticResource SettingsTextBrush}" />
                            </Grid>
                        </Border>

                        <WrapPanel Margin="0,14,0,0">
                            <Button AutomationProperties.AutomationId="SaveCaptureSettingsButton"
                                    Click="OnSaveCaptureSettingsClick"
                                    Content="{x:Static res:Strings.Common_Save}"
                                    Margin="0,0,10,10"
                                    MinWidth="96"
                                    Style="{StaticResource SettingsButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ResetCaptureSettingsButton"
                                    Click="OnResetCaptureSettingsClick"
                                    Content="{x:Static res:Strings.Common_ResetDefault}"
                                    Margin="0,0,10,10"
                                    MinWidth="96"
                                    Style="{StaticResource SettingsButtonStyle}" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="WindowExclusionsPanel"
                              AutomationProperties.AutomationId="WindowExclusionsPanel"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SettingsTextBrush}"
                                   Text="{x:Static res:Strings.Settings_WindowExclusion_Title}" />
                        <TextBlock Margin="0,5,0,18"
                                   FontSize="12"
                                   Foreground="{StaticResource SettingsMutedTextBrush}"
                                   Text="{x:Static res:Strings.Settings_WindowExclusion_Subtitle}" />

                        <Border Padding="14"
                                Background="{StaticResource SettingsPanelBrush}"
                                BorderBrush="{StaticResource SettingsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Button AutomationProperties.AutomationId="RefreshWindowExclusionProcessesButton"
                                            Click="OnRefreshWindowExclusionProcessesClick"
                                            Content="{x:Static res:Strings.Common_Refresh}"
                                            DockPanel.Dock="Right"
                                            Margin="10,0,0,8"
                                            MinWidth="96"
                                            Style="{StaticResource SettingsButtonStyle}" />
                                    <TextBlock Margin="0,0,0,8"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SettingsTextBrush}"
                                               Text="{x:Static res:Strings.Settings_WindowExclusion_RunningProcessLabel}" />
                                </DockPanel>
                                <ComboBox x:Name="RunningProcessBox"
                                          AutomationProperties.AutomationId="RunningProcessBox"
                                          ItemsSource="{Binding RunningProcessItems}"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource SettingsComboBoxStyle}"
                                           ToolTip="{x:Static res:Strings.Settings_WindowExclusion_RunningProcessTooltip}" />
                                <TextBlock Margin="0,7,0,10"
                                           FontSize="11"
                                           Foreground="{StaticResource SettingsMutedTextBrush}"
                                           Text="{x:Static res:Strings.Settings_WindowExclusion_RunningProcessHelp}" />
                                <Button AutomationProperties.AutomationId="AddRunningProcessExclusionButton"
                                        Click="OnAddRunningProcessExclusionClick"
                                        Content="{x:Static res:Strings.Settings_WindowExclusion_AddRunningProcess}"
                                        HorizontalAlignment="Left"
                                        MinWidth="152"
                                        Style="{StaticResource SettingsButtonStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="14"
                                Background="{StaticResource SettingsPanelBrush}"
                                BorderBrush="{StaticResource SettingsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,8"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SettingsTextBrush}"
                                           Text="{x:Static res:Strings.Settings_WindowExclusion_AddPathLabel}" />
                                <Grid MinWidth="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="106" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WindowExclusionPathBox"
                                              Grid.Column="0"
                                              MinWidth="0"
                                              MinHeight="32"
                                             Padding="8,4"
                                             Background="#F4F7FA"
                                             BorderBrush="#94A3B8"
                                             BorderThickness="1"
                                             Foreground="#101820"
                                             ToolTip="{x:Static res:Strings.Settings_WindowExclusion_PathTooltip}" />
                                    <Button Grid.Column="1"
                                            AutomationProperties.AutomationId="BrowseWindowExclusionPathButton"
                                            Click="OnBrowseWindowExclusionPathClick"
                                            Content="{x:Static res:Strings.Common_BrowseFile}"
                                            Margin="10,0,0,0"
                                            MinWidth="96"
                                            Style="{StaticResource SettingsButtonStyle}" />
                                </Grid>
                                <Button AutomationProperties.AutomationId="AddWindowExclusionPathButton"
                                        Click="OnAddWindowExclusionPathClick"
                                        Content="{x:Static res:Strings.Settings_WindowExclusion_AddPathButton}"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        MinWidth="112"
                                        Style="{StaticResource SettingsButtonStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="14"
                                Background="{StaticResource SettingsPanelBrush}"
                                BorderBrush="{StaticResource SettingsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Button AutomationProperties.AutomationId="RemoveWindowExclusionButton"
                                            Click="OnRemoveWindowExclusionClick"
                                            Content="{x:Static res:Strings.Settings_WindowExclusion_RemoveSelected}"
                                            DockPanel.Dock="Right"
                                            Margin="10,0,0,8"
                                            MinWidth="120"
                                            Style="{StaticResource SettingsButtonStyle}" />
                                    <TextBlock Margin="0,0,0,8"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SettingsTextBrush}"
                                                Text="{x:Static res:Strings.Settings_WindowExclusion_RegisteredLabel}" />
                                </DockPanel>
                                <StackPanel Margin="0,0,0,10"
                                            Orientation="Horizontal">
                                    <TextBlock Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource SettingsMutedTextBrush}"
                                               Text="{x:Static res:Strings.Settings_WindowExclusion_RuleLabel}" />
                                    <RadioButton x:Name="WindowExclusionFilePathRuleRadio"
                                                 Margin="0,0,14,0"
                                                 Checked="OnWindowExclusionRuleChanged"
                                                 Content="{x:Static res:Strings.Settings_WindowExclusion_RuleFilePath}"
                                                 Foreground="{StaticResource SettingsTextBrush}"
                                                 IsEnabled="False" />
                                    <RadioButton x:Name="WindowExclusionProcessNameRuleRadio"
                                                 Checked="OnWindowExclusionRuleChanged"
                                                 Content="{x:Static res:Strings.Settings_WindowExclusion_RuleProcessName}"
                                                 Foreground="{StaticResource SettingsTextBrush}"
                                                 IsEnabled="False" />
                                </StackPanel>
                                <ListBox x:Name="WindowExclusionList"
                                          AutomationProperties.AutomationId="WindowExclusionList"
                                          ItemsSource="{Binding WindowExclusionItems}"
                                          SelectionChanged="OnWindowExclusionSelectionChanged"
                                          MinHeight="150"
                                         BorderBrush="{StaticResource SettingsBorderBrush}"
                                         BorderThickness="1"
                                         Background="#111516"
                                         Foreground="{StaticResource SettingsTextBrush}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4">
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{StaticResource SettingsTextBrush}"
                                                           Text="{Binding DisplayName}" />
                                                 <TextBlock Margin="0,2,0,0"
                                                            FontSize="11"
                                                            Foreground="{StaticResource SettingsMutedTextBrush}"
                                                            Text="{Binding AppliedRuleText}" />
                                                 <TextBlock Margin="0,2,0,0"
                                                            FontSize="11"
                                                            Foreground="{StaticResource SettingsMutedTextBrush}"
                                                            Text="{Binding ExecutablePath}"
                                                            TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="ExtensionDefaultsPanel"
                      AutomationProperties.AutomationId="ExtensionDefaultsPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               LastChildFill="True">
                        <Button AutomationProperties.AutomationId="ShowExtensionAssociationHelpButton"
                                Click="OnShowExtensionHelpClick"
                                Content="{x:Static res:Strings.Common_ShowHelp}"
                                DockPanel.Dock="Right"
                                Margin="12,0,0,0"
                                MinWidth="96"
                                Style="{StaticResource SettingsButtonStyle}" />
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SettingsTextBrush}"
                                       Text="{x:Static res:Strings.Settings_Section_ExtensionDefaults}" />
                            <TextBlock Margin="0,5,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource SettingsMutedTextBrush}"
                                       Text="{x:Static res:Strings.Settings_Extension_Subtitle}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1"
                            Margin="0,18,0,12"
                            Padding="14,12"
                            Background="{StaticResource SettingsPanelAltBrush}"
                            BorderBrush="{StaticResource SettingsBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SettingsTextBrush}"
                                       Text="{x:Static res:Strings.Settings_Extension_StatusTitle}" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,6,20,0"
                                       FontSize="12"
                                       Foreground="{StaticResource SettingsMutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="{x:Static res:Strings.Settings_Extension_StatusHelp}" />
                            <TextBlock Grid.Row="0"
                                       Grid.RowSpan="2"
                                       Grid.Column="1"
                                       x:Name="AssociationSummaryText"
                                       AutomationProperties.AutomationId="AssociationSummaryText"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#5EEAD4"
                                       Text="{x:Static res:Strings.Settings_Extension_StatusPending}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Border Padding="14"
                                    Background="{StaticResource SettingsPanelBrush}"
                                    BorderBrush="{StaticResource SettingsBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <StackPanel>
                                    <TextBlock FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SettingsTextBrush}"
                                               Text="{x:Static res:Strings.Settings_Extension_ImageExtensionsTitle}" />
                                    <TextBlock Margin="0,4,0,12"
                                               FontSize="12"
                                               Foreground="{StaticResource SettingsMutedTextBrush}"
                                               Text="{x:Static res:Strings.Settings_Extension_ImageExtensionsHelp}" />

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="AdditionalImageExtensionBox"
                                                 AutomationProperties.AutomationId="AdditionalImageExtensionBox"
                                                 MinHeight="34"
                                                 Padding="10,6"
                                                 VerticalContentAlignment="Center"
                                                 Background="#121414"
                                                 BorderBrush="{StaticResource SettingsBorderBrush}"
                                                 BorderThickness="1"
                                                 Foreground="{StaticResource SettingsTextBrush}"
                                                 ToolTip="{x:Static res:Strings.Settings_Extension_ExtensionInputTooltip}" />
                                        <Button Grid.Column="1"
                                                AutomationProperties.AutomationId="AddImageExtensionButton"
                                                Click="OnAddImageExtensionClick"
                                                Content="{x:Static res:Strings.Settings_Extension_RegisterButton}"
                                                Margin="10,0,0,0"
                                                MinWidth="112"
                                                Style="{StaticResource SettingsButtonStyle}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="92" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="11" Foreground="{StaticResource SettingsMutedTextBrush}" Text="{x:Static res:Strings.Settings_Extension_ColumnExtension}" />
                                        <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource SettingsMutedTextBrush}" Text="{x:Static res:Strings.Settings_Extension_ColumnFormat}" />
                                        <TextBlock Grid.Column="2" FontSize="11" Foreground="{StaticResource SettingsMutedTextBrush}" Text="{x:Static res:Strings.Settings_Extension_ColumnCurrentApp}" />
                                        <TextBlock Grid.Column="3" FontSize="11" Foreground="{StaticResource SettingsMutedTextBrush}" Text="{x:Static res:Strings.Settings_Extension_ColumnEdit}" />
                                    </Grid>

                                    <ItemsControl x:Name="ExtensionItemsList"
                                                  AutomationProperties.AutomationId="ExtensionItemsList"
                                                  ItemsSource="{Binding ExtensionItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="38">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="86" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="190" />
                                                        <ColumnDefinition Width="92" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource SettingsTextBrush}"
                                                               Text="{Binding Extension}" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="0,0,12,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource SettingsMutedTextBrush}"
                                                               Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Foreground="{Binding StatusBrush}"
                                                               Text="{Binding StatusText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding StatusDetail}" />
                                                    <Button Grid.Column="3"
                                                            Width="72"
                                                            Margin="0,2,0,2"
                                                            HorizontalAlignment="Left"
                                                            AutomationProperties.Name="{Binding ChangeAutomationName}"
                                                            Click="OnOpenDefaultAppsClick"
                                                            Content="{x:Static res:Strings.Settings_Extension_ColumnEdit}"
                                                            Style="{StaticResource SettingsButtonStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <Border Grid.Row="1"
                                Margin="0,6,0,0"
                                Padding="10,10,10,0"
                                Background="{StaticResource SettingsBackgroundBrush}"
                                BorderBrush="{StaticResource SettingsBorderBrush}"
                                BorderThickness="0,1,0,0">
                            <WrapPanel>
                                <Button AutomationProperties.AutomationId="OpenWindowsDefaultAppsButton"
                                        Click="OnOpenDefaultAppsClick"
                                        Content="{x:Static res:Strings.Settings_Extension_OpenDefaultApps}"
                                        Margin="0,0,10,10"
                                        MinWidth="220"
                                        Style="{StaticResource SettingsButtonStyle}" />
                                <Button AutomationProperties.AutomationId="ShowExtensionAssociationHelpFooterButton"
                                        Click="OnShowExtensionHelpClick"
                                        Content="{x:Static res:Strings.Common_ShowHelp}"
                                        Margin="0,0,10,10"
                                        MinWidth="96"
                                        Style="{StaticResource SettingsButtonStyle}" />
                                <Button AutomationProperties.AutomationId="RegisterExtensionCandidatesButton"
                                        Click="OnRegisterAssociationCandidatesClick"
                                        Content="{x:Static res:Strings.Settings_Extension_RestoreCandidates}"
                                        Margin="0,0,10,10"
                                        MinWidth="128"
                                        Style="{StaticResource SettingsButtonStyle}" />
                                <Button AutomationProperties.AutomationId="RefreshExtensionAssociationsButton"
                                        Click="OnRefreshAssociationsClick"
                                        Content="{x:Static res:Strings.Common_Refresh}"
                                        Margin="0,0,10,10"
                                        MinWidth="96"
                                        Style="{StaticResource SettingsButtonStyle}" />
                                <Button AutomationProperties.AutomationId="CopyExecutablePathButton"
                                        Click="OnCopyExecutablePathClick"
                                        Content="{x:Static res:Strings.Settings_Extension_CopyExecutablePath}"
                                        Margin="0,0,0,10"
                                        MinWidth="178"
                                        Style="{StaticResource SettingsButtonStyle}" />
                            </WrapPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Margin="0,8,0,0"
                                Padding="12,9"
                                Background="#101213"
                                BorderBrush="{StaticResource SettingsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock x:Name="ExecutablePathText"
                                       AutomationProperties.AutomationId="SettingsExecutablePathText"
                                       FontSize="12"
                                       Foreground="{StaticResource SettingsMutedTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>

                        <TextBlock Grid.Row="3"
                                   x:Name="SettingsStatusText"
                                   AutomationProperties.AutomationId="SettingsStatusText"
                                   Margin="0,12,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource SettingsMutedTextBrush}" />
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="LanguagePanel"
                              AutomationProperties.AutomationId="LanguagePanel"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SettingsTextBrush}"
                                   Text="{x:Static res:Strings.Settings_Section_Language}" />
                        <TextBlock Margin="0,5,0,18"
                                   FontSize="12"
                                   Foreground="{StaticResource SettingsMutedTextBrush}"
                                   Text="{x:Static res:Strings.Settings_Language_Subtitle}" />

                        <Border Padding="14"
                                Background="{StaticResource SettingsPanelBrush}"
                                BorderBrush="{StaticResource SettingsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,8"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SettingsTextBrush}"
                                           Text="{x:Static res:Strings.Settings_Language_Label}" />
                                <ComboBox x:Name="LanguageComboBox"
                                          AutomationProperties.AutomationId="LanguageComboBox"
                                          Width="240"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding LanguageOptions}"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource SettingsComboBoxStyle}" />
                                <Button AutomationProperties.AutomationId="ApplyLanguageButton"
                                        Click="OnApplyLanguageClick"
                                        Content="{x:Static res:Strings.Settings_Language_ApplyButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0"
                                        MinWidth="152"
                                        Style="{StaticResource SettingsButtonStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="18,0"
                Background="#101213"
                BorderBrush="{StaticResource SettingsBorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource SettingsMutedTextBrush}"
                       Text="{x:Static res:Strings.Settings_Footer_DefaultAppNotice}" />
        </Border>
    </Grid>
</Window>
