<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>MiniCapture.Program</StartupObject>
    <ApplicationIcon>Assets\App\MiniCapture.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\App\MiniCapture.ico" />
    <Resource Include="Assets\App\MiniCapture.png" />
    <Resource Include="Assets\Toolbar\*.png" />
  </ItemGroup>

</Project>
