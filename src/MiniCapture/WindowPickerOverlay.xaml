<Window x:Class="MiniCapture.WindowPickerOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Capture Window Picker"
        AllowsTransparency="True"
        Background="Transparent"
        Cursor="Cross"
        Focusable="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        Loaded="OnLoaded"
        SourceInitialized="OnSourceInitialized"
        Closed="OnClosed"
        >
    <Canvas x:Name="OverlayCanvas"
            Background="Transparent">
        <Border x:Name="HighlightBorder"
                Visibility="Collapsed"
                BorderBrush="#12a594"
                BorderThickness="3"
                CornerRadius="7"
                Background="#1112a594" />
        <TextBlock x:Name="HintText"
                   Padding="10,7"
                   FontFamily="Segoe UI"
                   FontSize="13"
                   Foreground="White"
                   Background="#cc18212f"
                   Text="캡처할 창 위에 마우스를 올리고 클릭 / Esc 취소" />
        <TextBlock x:Name="TargetText"
                   Visibility="Collapsed"
                   Padding="9,6"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   Foreground="White"
                   Background="#cc0f766e"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="420" />
    </Canvas>
</Window>
