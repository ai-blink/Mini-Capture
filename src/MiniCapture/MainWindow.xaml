<Window x:Class="MiniCapture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Capture"
        Icon="Assets/App/MiniCapture.ico"
        Width="96"
        Height="96"
        MinWidth="96"
        MinHeight="96"
        MaxWidth="96"
        MaxHeight="96"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        Loaded="OnLoaded"
        SourceInitialized="OnSourceInitialized"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <DropShadowEffect x:Key="FloatingShadow"
                          BlurRadius="28"
                          Direction="270"
                          Opacity="0.28"
                          ShadowDepth="12"
                          Color="#075e57" />

        <DropShadowEffect x:Key="ModeButtonShadow"
                          BlurRadius="22"
                          Direction="270"
                          Opacity="0.16"
                          ShadowDepth="10"
                          Color="#1f2937" />

        <Style x:Key="ModeButtonStyle" TargetType="Button">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="22" />
                </Style>
            </Style.Resources>
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#ffffff" />
            <Setter Property="BorderBrush" Value="#cbd5e1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#263245" />
            <Setter Property="Effect" Value="{StaticResource ModeButtonShadow}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Button x:Name="CaptureButton"
                Width="58"
                Height="58"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="CaptureButton"
                AutomationProperties.Name="Capture menu"
                Background="#b812a594"
                BorderBrush="#e6ffffff"
                BorderThickness="1"
                Click="OnCaptureButtonClick"
                Cursor="Hand"
                Effect="{StaticResource FloatingShadow}"
                FontFamily="Segoe UI"
                Foreground="White"
                PreviewMouseLeftButtonDown="OnCaptureButtonPreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="OnCaptureButtonPreviewMouseLeftButtonUp"
                PreviewMouseMove="OnCaptureButtonPreviewMouseMove"
                ToolTip="캡처 메뉴 열기. 드래그하면 위치를 옮길 수 있습니다. 우클릭하면 이미지 뷰어, 설정, 종료 메뉴를 열 수 있습니다.">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="29" />
                </Style>
            </Button.Resources>
            <Button.ContextMenu>
                <ContextMenu Opened="OnCaptureButtonContextMenuOpened">
                    <MenuItem Header="이미지 뷰어"
                              AutomationProperties.AutomationId="OpenImageViewerMenuItem"
                              Click="OnOpenViewerEntryClick" />
                    <MenuItem Header="설정"
                              AutomationProperties.AutomationId="OpenSettingsMenuItem"
                              Click="OnOpenSettingsClick" />
                    <Separator />
                    <MenuItem Header="종료"
                              AutomationProperties.AutomationId="ExitMenuItem"
                              Click="OnExitClick" />
                </ContextMenu>
            </Button.ContextMenu>
            <Grid>
                <Border Width="35"
                        Height="35"
                        BorderBrush="White"
                        BorderThickness="2"
                        CornerRadius="6" />
            </Grid>
        </Button>

        <Popup x:Name="ModePopup"
               AllowsTransparency="True"
               Opened="OnOverlayPopupOpened"
               Placement="Top"
               PlacementTarget="{Binding ElementName=CaptureButton}"
               PopupAnimation="Fade"
               StaysOpen="True"
               HorizontalOffset="-48"
               VerticalOffset="49">
            <Canvas Width="150"
                    Height="155">
                <Button x:Name="ModeDragButton"
                        Canvas.Left="27"
                        Canvas.Top="63"
                        AutomationProperties.AutomationId="ModeDragButton"
                        AutomationProperties.Name="Drag mode"
                        Click="OnModeButtonClick"
                        Content="영역"
                        Style="{StaticResource ModeButtonStyle}"
                        Tag="Drag"
                        ToolTip="드래그 영역 캡처" />
                <Button x:Name="ModeWindowButton"
                        Canvas.Left="71"
                        Canvas.Top="57"
                        AutomationProperties.AutomationId="ModeWindowButton"
                        AutomationProperties.Name="Window mode"
                        Click="OnModeButtonClick"
                        Content="창"
                        Style="{StaticResource ModeButtonStyle}"
                        Tag="Window"
                        ToolTip="창 지정 캡처" />
                <Button x:Name="ModeFullScreenButton"
                        Canvas.Left="106"
                        Canvas.Top="84"
                        AutomationProperties.AutomationId="ModeFullScreenButton"
                        AutomationProperties.Name="Full screen mode"
                        Click="OnModeButtonClick"
                        Content="전체"
                        Style="{StaticResource ModeButtonStyle}"
                        Tag="FullScreen"
                        ToolTip="전체 화면 캡처" />
                <Button x:Name="ModeTimerButton"
                        Canvas.Left="0"
                        Canvas.Top="98"
                        AutomationProperties.AutomationId="ModeTimerButton"
                        AutomationProperties.Name="Timer delay"
                        Click="OnTimerButtonClick"
                        Content="타이머"
                        Style="{StaticResource ModeButtonStyle}"
                        ToolTip="캡처 전 지연 시간 선택" />
            </Canvas>
        </Popup>

        <Popup x:Name="TimerPopup"
               AllowsTransparency="True"
               Opened="OnOverlayPopupOpened"
               Placement="Right"
               PlacementTarget="{Binding ElementName=CaptureButton}"
               PopupAnimation="Fade"
               StaysOpen="True"
               HorizontalOffset="10">
            <Border Padding="10"
                    Background="#fbffffff"
                    BorderBrush="#d6dde6"
                    BorderThickness="1"
                    CornerRadius="8"
                    Effect="{StaticResource FloatingShadow}">
                <StackPanel Orientation="Horizontal">
                    <Button AutomationProperties.AutomationId="Timer3Button"
                            AutomationProperties.Name="Delay 3 seconds"
                            Click="OnTimerDelayClick"
                            Content="3초"
                            Margin="0,0,6,0"
                            Padding="10,6"
                            Tag="3" />
                    <Button AutomationProperties.AutomationId="Timer5Button"
                            AutomationProperties.Name="Delay 5 seconds"
                            Click="OnTimerDelayClick"
                            Content="5초"
                            Margin="0,0,6,0"
                            Padding="10,6"
                            Tag="5" />
                    <Button AutomationProperties.AutomationId="Timer7Button"
                            AutomationProperties.Name="Delay 7 seconds"
                            Click="OnTimerDelayClick"
                            Content="7초"
                            Margin="0,0,6,0"
                            Padding="10,6"
                            Tag="7" />
                    <Button AutomationProperties.AutomationId="Timer10Button"
                            AutomationProperties.Name="Delay 10 seconds"
                            Click="OnTimerDelayClick"
                            Content="10초"
                            Padding="10,6"
                            Tag="10" />
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="StatusPopup"
               AllowsTransparency="True"
               Opened="OnOverlayPopupOpened"
               IsHitTestVisible="False"
               Placement="Right"
               PlacementTarget="{Binding ElementName=CaptureButton}"
               StaysOpen="True"
               HorizontalOffset="10">
            <Border Width="238"
                    Padding="12,9"
                    Background="#fb18212f"
                    CornerRadius="8"
                    Effect="{StaticResource FloatingShadow}">
                <TextBlock x:Name="StatusText"
                           AutomationProperties.AutomationId="ModeStatusText"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="White"
                           TextWrapping="Wrap" />
            </Border>
        </Popup>

        <Popup x:Name="ResultPopup"
               AllowsTransparency="True"
               Opened="OnOverlayPopupOpened"
               Placement="Right"
               PlacementTarget="{Binding ElementName=CaptureButton}"
               StaysOpen="True"
               HorizontalOffset="10"
               VerticalOffset="58">
            <Border Width="330"
                    Padding="12"
                    Background="#fbffffff"
                    BorderBrush="#d6dde6"
                    BorderThickness="1"
                    CornerRadius="10"
                    Effect="{StaticResource FloatingShadow}">
                <StackPanel>
                    <TextBlock FontFamily="Segoe UI"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#18212f"
                               Text="저장됨" />
                    <TextBlock x:Name="ResultPathText"
                               Margin="0,5,0,10"
                               AutomationProperties.AutomationId="ResultPathText"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="#627083"
                               TextTrimming="CharacterEllipsis" />
                    <WrapPanel>
                        <Button AutomationProperties.AutomationId="OpenFileButton"
                                Click="OnOpenFileClick"
                                Content="열기"
                                Margin="0,0,8,0"
                                Padding="10,6"
                                MinWidth="58" />
                        <Button AutomationProperties.AutomationId="OpenFolderButton"
                                Click="OnOpenFolderClick"
                                Content="폴더"
                                Margin="0,0,8,0"
                                Padding="10,6"
                                MinWidth="58" />
                        <Button AutomationProperties.AutomationId="OpenViewerButton"
                                Click="OnOpenViewerClick"
                                Content="보기"
                                Margin="0,0,8,0"
                                Padding="10,6"
                                MinWidth="58" />
                        <Button AutomationProperties.AutomationId="CopyPathButton"
                                Click="OnCopyPathClick"
                                Content="경로 복사"
                                Margin="0,0,8,0"
                                Padding="10,6"
                                MinWidth="76" />
                        <Button AutomationProperties.AutomationId="CopyImageButton"
                                Click="OnCopyImageClick"
                                Content="이미지 복사"
                                Margin="0,6,8,0"
                                Padding="10,6"
                                MinWidth="86" />
                        <Button AutomationProperties.AutomationId="DismissResultButton"
                                Click="OnDismissResultClick"
                                Content="닫기"
                                Margin="0,6,0,0"
                                Padding="10,6"
                                MinWidth="58" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
