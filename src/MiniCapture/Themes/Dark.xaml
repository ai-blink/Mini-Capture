<!-- 다크 테마 색. Light.xaml과 키 목록이 같아야 한다(한쪽에만 있으면 그 테마에서 StaticResource가 실패). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 뷰어 -->
    <SolidColorBrush x:Key="ViewerWindowBackgroundBrush" Color="#121414" />
    <SolidColorBrush x:Key="ViewerToolbarBackgroundBrush" Color="#16191A" />
    <SolidColorBrush x:Key="ViewerPanelBackgroundBrush" Color="#181B1C" />
    <SolidColorBrush x:Key="ViewerPanelRaisedBrush" Color="#1F2427" />
    <SolidColorBrush x:Key="ViewerPanelTintBrush" Color="#1A2322" />
    <SolidColorBrush x:Key="ViewerHoverBrush" Color="#232A2E" />
    <SolidColorBrush x:Key="ViewerBorderBrush" Color="#31383E" />
    <SolidColorBrush x:Key="ViewerMutedBorderBrush" Color="#425160" />
    <SolidColorBrush x:Key="ViewerAccentBrush" Color="#2A9D93" />
    <SolidColorBrush x:Key="ViewerAccentMutedBrush" Color="#173C39" />
    <SolidColorBrush x:Key="ViewerOnAccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ViewerTextBrush" Color="#E6E8EA" />
    <SolidColorBrush x:Key="ViewerMutedTextBrush" Color="#A8B0B8" />
    <SolidColorBrush x:Key="ViewerDimTextBrush" Color="#8A949C" />

    <!-- 설정 창·키 감지 대화상자 -->
    <SolidColorBrush x:Key="SettingsBackgroundBrush" Color="#121414" />
    <SolidColorBrush x:Key="SettingsHeaderBrush" Color="#16191A" />
    <SolidColorBrush x:Key="SettingsDeepBrush" Color="#101213" />
    <SolidColorBrush x:Key="SettingsPanelBrush" Color="#181B1C" />
    <SolidColorBrush x:Key="SettingsPanelAltBrush" Color="#1F2427" />
    <SolidColorBrush x:Key="SettingsBorderBrush" Color="#31383E" />
    <SolidColorBrush x:Key="SettingsAccentBrush" Color="#2A9D93" />
    <SolidColorBrush x:Key="SettingsSelectedBrush" Color="#173C39" />
    <SolidColorBrush x:Key="SettingsTextBrush" Color="#E6E8EA" />
    <SolidColorBrush x:Key="SettingsMutedTextBrush" Color="#A8B0B8" />
    <SolidColorBrush x:Key="SettingsHighlightTextBrush" Color="#5EEAD4" />
    <SolidColorBrush x:Key="SettingsSuccessTextBrush" Color="#90EE90" />
    <SolidColorBrush x:Key="SettingsInfoTextBrush" Color="#B0C4DE" />
    <SolidColorBrush x:Key="SettingsButtonBrush" Color="#25303A" />
    <SolidColorBrush x:Key="SettingsButtonBorderBrush" Color="#425160" />
    <SolidColorBrush x:Key="SettingsInputBrush" Color="#F4F7FA" />
    <SolidColorBrush x:Key="SettingsInputBorderBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="SettingsInputTextBrush" Color="#101820" />
    <SolidColorBrush x:Key="SettingsScrollForegroundBrush" Color="#708090" />
    <SolidColorBrush x:Key="SettingsScrollThumbBrush" Color="#526170" />
</ResourceDictionary>
