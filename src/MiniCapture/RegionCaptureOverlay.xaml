<Window x:Class="MiniCapture.RegionCaptureOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Capture Region Overlay"
        AllowsTransparency="True"
        Background="Transparent"
        Cursor="Cross"
        Focusable="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        Loaded="OnLoaded"
        SourceInitialized="OnSourceInitialized"
        Closed="OnClosed">
    <Canvas x:Name="OverlayCanvas"
            Background="Transparent">
        <Border x:Name="SelectionBorder"
                Visibility="Collapsed"
                BorderBrush="#12a594"
                BorderThickness="2"
                Background="#2212a594" />
        <TextBlock x:Name="HintText"
                   Padding="10,7"
                   FontFamily="Segoe UI"
                   FontSize="13"
                   Foreground="White"
                   Background="#cc18212f"
                   Text="드래그해서 캡처 영역 선택 / Esc 취소" />
    </Canvas>
</Window>
