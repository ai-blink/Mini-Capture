<Window x:Class="MiniCapture.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MiniCapture"
        Title="Mini Capture Viewer"
        Icon="Assets/App/MiniCapture.ico"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="580"
        Background="#EEF1F1"
        FontFamily="Segoe UI"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        PreviewKeyDown="OnKeyDown"
        KeyUp="OnKeyUp">
    <Window.Resources>
        <SolidColorBrush x:Key="ViewerWindowBackgroundBrush" Color="#EEF1F1" />
        <SolidColorBrush x:Key="ViewerToolbarBackgroundBrush" Color="#F1F4F4" />
        <SolidColorBrush x:Key="ViewerToolbarGroupBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ViewerToolbarGroupAltBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ViewerPanelBackgroundBrush" Color="#FAFBFB" />
        <SolidColorBrush x:Key="ViewerPanelRaisedBrush" Color="#F6F8F8" />
        <SolidColorBrush x:Key="ViewerBorderBrush" Color="#CCD4D4" />
        <SolidColorBrush x:Key="ViewerMutedBorderBrush" Color="#B9C4C5" />
        <SolidColorBrush x:Key="ViewerAccentBrush" Color="#197F78" />
        <SolidColorBrush x:Key="ViewerAccentMutedBrush" Color="#D8EEEB" />
        <SolidColorBrush x:Key="ViewerTextBrush" Color="#293638" />
        <SolidColorBrush x:Key="ViewerMutedTextBrush" Color="#59686A" />
        <SolidColorBrush x:Key="ViewerDimTextBrush" Color="#748184" />

        <DrawingBrush x:Key="ViewerCanvasDotBrush"
                      TileMode="Tile"
                      Viewport="0,0,24,24"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1E1E1E">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,24,24" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#34383B">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="12,12"
                                             RadiusX="1"
                                             RadiusY="1" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <DataTemplate x:Key="ToolbarIconWithLabelTemplate">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ContentPresenter HorizontalAlignment="Center"
                                  Content="{Binding}" />
                <TextBlock Margin="0,1,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontSize="9"
                           Foreground="{StaticResource ViewerMutedTextBrush}"
                           Text="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=(AutomationProperties.Name)}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ColorSwatchWithLabelTemplate">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ContentPresenter HorizontalAlignment="Center"
                                  Content="{Binding}" />
                <TextBlock Margin="0,2,0,0"
                           HorizontalAlignment="Center"
                           FontSize="9"
                           Foreground="{StaticResource ViewerMutedTextBrush}"
                           Text="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=(AutomationProperties.Name)}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource ViewerTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FAFBFB" />
                    <Setter Property="BorderBrush" Value="{StaticResource ViewerBorderBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RibbonTextButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PrimaryRibbonButtonStyle" TargetType="Button" BasedOn="{StaticResource RibbonTextButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ViewerAccentBrush}" />
            <Setter Property="BorderBrush" Value="#197F78" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="HeaderActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="HeaderPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ViewerAccentBrush}" />
            <Setter Property="BorderBrush" Value="#197F78" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>

        <Style x:Key="ToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ZoomIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="ToolGlyphButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
            <Setter Property="Width" Value="38" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="RibbonGroupStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="0,0,8,0" />
            <Setter Property="Background" Value="{StaticResource ViewerToolbarGroupBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>

        <Style x:Key="RibbonGroupLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource ViewerDimTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerMutedBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
        </Style>

        <Style x:Key="ColorSwatchFillStyle" TargetType="Border">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="BorderBrush" Value="#0C0F0F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="ToolbarPropertyLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource ViewerDimTextBrush}" />
        </Style>

        <Style x:Key="ViewButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Background" Value="#20272D" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerMutedBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>

        <Style x:Key="ExplorerListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource ViewerTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ViewerAccentMutedBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ViewerAccentBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8EEEE" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource ExplorerListItemStyle}">
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="#F1F4F4" />
            <Setter Property="Foreground" Value="{StaticResource ViewerMutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <ItemsPanelTemplate x:Key="IconItemsPanel">
            <WrapPanel IsItemsHost="True"
                       MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListView}}"
                       Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="DetailsItemsPanel">
            <VirtualizingStackPanel IsItemsHost="True" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="SmallIconTemplate">
            <Border Width="104"
                    Padding="6"
                    Background="Transparent">
                <StackPanel>
                    <Border Height="58"
                            Background="#E8EEEE"
                            BorderBrush="{StaticResource ViewerMutedBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Image Source="{Binding SmallThumbnail}"
                               Stretch="Uniform" />
                    </Border>
                    <TextBlock Margin="0,5,0,0"
                               FontSize="11"
                               Foreground="{StaticResource ViewerTextBrush}"
                               Text="{Binding FileName}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MediumIconTemplate">
            <Border Width="138"
                    Padding="7"
                    Background="Transparent">
                <StackPanel>
                    <Border Height="92"
                            Background="#E8EEEE"
                            BorderBrush="{StaticResource ViewerMutedBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Image Source="{Binding MediumThumbnail}"
                               Stretch="Uniform" />
                    </Border>
                    <TextBlock Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{StaticResource ViewerTextBrush}"
                               Text="{Binding FileName}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LargeIconTemplate">
            <Border Width="184"
                    Padding="8"
                    Background="Transparent">
                <StackPanel>
                    <Border Height="132"
                            Background="#E8EEEE"
                            BorderBrush="{StaticResource ViewerMutedBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Image Source="{Binding LargeThumbnail}"
                               Stretch="Uniform" />
                    </Border>
                    <TextBlock Margin="0,7,0,0"
                               FontSize="12"
                               Foreground="{StaticResource ViewerTextBrush}"
                               Text="{Binding FileName}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type local:FolderTreeNode}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Width="18"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="13"
                           Foreground="{StaticResource ViewerMutedTextBrush}"
                           Text="{Binding IconGlyph}" />
                <StackPanel>
                    <TextBlock Foreground="{StaticResource ViewerTextBrush}"
                               Text="{Binding Name}" />
                    <TextBlock FontSize="10"
                               Foreground="{StaticResource ViewerDimTextBrush}"
                               Text="{Binding Detail}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource ViewerWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FAFBFB"
                BorderBrush="{StaticResource ViewerBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="24"
                        Height="24"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource ViewerAccentBrush}"
                        CornerRadius="5">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Bahnschrift"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="M" />
                </Border>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentFileText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ViewerTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="10"
                               Foreground="{StaticResource ViewerDimTextBrush}"
                               Text="Mini Capture Viewer" />
                </StackPanel>
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button AutomationProperties.AutomationId="ViewerHeaderSaveButton"
                            AutomationProperties.Name="저장"
                            Click="OnSaveClick"
                            Content="저장"
                            ToolTip="저장 (Ctrl+S)"
                            Style="{StaticResource HeaderPrimaryActionButtonStyle}" />
                    <Button AutomationProperties.AutomationId="ViewerHeaderCopyImageButton"
                            AutomationProperties.Name="이미지 복사"
                            Click="OnCopyImageClick"
                            Content="이미지 복사"
                            ToolTip="이미지 복사 (Ctrl+C)"
                            Style="{StaticResource HeaderActionButtonStyle}" />
                    <Button AutomationProperties.AutomationId="ViewerHeaderCopyPathButton"
                            AutomationProperties.Name="파일 경로 복사"
                            Click="OnCopyPathClick"
                            Content="경로 복사"
                            ToolTip="파일 경로 복사 (Ctrl+Shift+C)"
                            Style="{StaticResource HeaderActionButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource ViewerToolbarBackgroundBrush}"
                BorderBrush="{StaticResource ViewerBorderBrush}"
                BorderThickness="0,0,0,1">
            <WrapPanel Margin="10,7,0,2"
                       Orientation="Horizontal">
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource RibbonGroupLabelStyle}"
                                       Text="파일" />
                            <Button AutomationProperties.AutomationId="ViewerSaveButton"
                                    AutomationProperties.Name="저장"
                                    Click="OnSaveClick"
                                    Content="저장"
                                    ToolTip="저장"
                                    Style="{StaticResource PrimaryRibbonButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerOpenButton"
                                    AutomationProperties.Name="열기"
                                    Click="OnOpenClick"
                                    Content="열기"
                                    ToolTip="열기"
                                    Style="{StaticResource RibbonTextButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerOpenFolderButton"
                                    AutomationProperties.Name="폴더 열기"
                                    Click="OnOpenFolderClick"
                                    Content="폴더 열기"
                                    ToolTip="폴더 열기"
                                    Style="{StaticResource RibbonTextButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerCopyImageButton"
                                    AutomationProperties.Name="이미지 복사"
                                    Click="OnCopyImageClick"
                                    Content="이미지 복사"
                                    ToolTip="마크업 포함 이미지 복사"
                                    Style="{StaticResource RibbonTextButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerCopyPathButton"
                                    AutomationProperties.Name="파일 경로 복사"
                                    Click="OnCopyPathClick"
                                    Content="경로 복사"
                                    ToolTip="파일 경로 복사"
                                    Style="{StaticResource RibbonTextButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource RibbonGroupLabelStyle}"
                                       Text="보기" />
                            <Button x:Name="PreviousButton"
                                    AutomationProperties.AutomationId="ViewerPreviousButton"
                                    AutomationProperties.Name="이전"
                                    Click="OnPreviousClick"
                                    Content="&#xE76B;"
                                    ToolTip="이전 이미지"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                            <Button x:Name="NextButton"
                                    AutomationProperties.AutomationId="ViewerNextButton"
                                    AutomationProperties.Name="다음"
                                    Click="OnNextClick"
                                    Content="&#xE76C;"
                                    ToolTip="다음 이미지"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerFitButton"
                                    AutomationProperties.Name="맞춤"
                                    Click="OnFitClick"
                                    Content="&#xE9A6;"
                                    ToolTip="창에 맞춤"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerActualSizeButton"
                                    AutomationProperties.Name="원본"
                                    Click="OnActualSizeClick"
                                    Content="1:1"
                                    FontFamily="Segoe UI"
                                    FontSize="11"
                                    ToolTip="원본 크기"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerZoomOutButton"
                                    AutomationProperties.Name="축소"
                                    Click="OnZoomOutClick"
                                    Content="−"
                                    ToolTip="축소"
                                    Style="{StaticResource ZoomIconButtonStyle}" />
                            <TextBox x:Name="ZoomText"
                                     Width="54"
                                     Height="28"
                                     Margin="2,0,3,0"
                                     Padding="3,0"
                                     VerticalAlignment="Center"
                                     AutomationProperties.AutomationId="ViewerZoomInput"
                                     AutomationProperties.Name="확대/축소 퍼센트"
                                     Background="#FAFBFB"
                                     BorderBrush="{StaticResource ViewerMutedBorderBrush}"
                                     Foreground="{StaticResource ViewerTextBrush}"
                                     GotKeyboardFocus="OnZoomTextGotKeyboardFocus"
                                     LostKeyboardFocus="OnZoomTextLostKeyboardFocus"
                                     PreviewKeyDown="OnZoomTextPreviewKeyDown"
                                     TextAlignment="Center"
                                     ToolTip="확대/축소 퍼센트 직접 입력 (10%~800%)"
                                     VerticalContentAlignment="Center" />
                            <Button AutomationProperties.AutomationId="ViewerZoomInButton"
                                    AutomationProperties.Name="확대"
                                    Click="OnZoomInClick"
                                    Content="+"
                                    ToolTip="확대"
                                    Style="{StaticResource ZoomIconButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerRefreshButton"
                                    AutomationProperties.Name="새로고침"
                                    Click="OnRefreshClick"
                                    Content="&#xE72C;"
                                    ToolTip="파일 목록 새로고침 (F5)"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource ViewerToolbarGroupAltBrush}"
                            Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource RibbonGroupLabelStyle}"
                                       Text="마크업" />
                            <Button x:Name="PanToolButton"
                                    AutomationProperties.AutomationId="ViewerPanToolButton"
                                    AutomationProperties.Name="핸드"
                                    Click="OnToolButtonClick"
                                    ToolTip="핸드툴"
                                    Style="{StaticResource ToolGlyphButtonStyle}"
                                    Tag="Pan">
                                <Image Width="22"
                                       Height="22"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="pack://application:,,,/Assets/Toolbar/pan-tool.png"
                                       Stretch="Uniform" />
                            </Button>
                            <Button x:Name="SelectToolButton"
                                    AutomationProperties.AutomationId="ViewerSelectToolButton"
                                    AutomationProperties.Name="선택"
                                    Click="OnToolButtonClick"
                                    ToolTip="선택"
                                    Style="{StaticResource ToolGlyphButtonStyle}"
                                    Tag="Select">
                                <Image Width="22"
                                       Height="22"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="pack://application:,,,/Assets/Toolbar/select-tool.png"
                                       Stretch="Uniform" />
                            </Button>
                            <Button x:Name="PenToolButton"
                                    AutomationProperties.AutomationId="ViewerPenToolButton"
                                    AutomationProperties.Name="펜"
                                    Click="OnToolButtonClick"
                                    Content="✎"
                                    ToolTip="펜"
                                    Style="{StaticResource ToolGlyphButtonStyle}"
                                    Tag="Pen" />
                            <Button x:Name="ArrowToolButton"
                                    AutomationProperties.AutomationId="ViewerArrowToolButton"
                                    AutomationProperties.Name="화살표"
                                    Click="OnToolButtonClick"
                                    Content="↗"
                                    ToolTip="화살표"
                                    Style="{StaticResource ToolGlyphButtonStyle}"
                                    Tag="Arrow" />
                            <Button x:Name="RectangleToolButton"
                                    AutomationProperties.AutomationId="ViewerRectangleToolButton"
                                    AutomationProperties.Name="네모"
                                    Click="OnToolButtonClick"
