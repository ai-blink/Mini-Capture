<Window x:Class="MiniCapture.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:MiniCapture.Resources"
        xmlns:local="clr-namespace:MiniCapture"
        Title="Mini Capture Viewer"
        Icon="Assets/App/MiniCapture.ico"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="580"
        Background="{StaticResource ViewerWindowBackgroundBrush}"
        FontFamily="Segoe UI"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        PreviewKeyDown="OnKeyDown"
        KeyUp="OnKeyUp">
    <Window.Resources>
        <!-- 테마 색(Viewer*Brush)은 App 리소스의 Themes/Light.xaml·Dark.xaml에서 온다. -->
        <SolidColorBrush x:Key="ViewerToolbarGroupBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ViewerToolbarGroupAltBrush" Color="Transparent" />


        <DrawingBrush x:Key="ViewerCanvasDotBrush"
                      TileMode="Tile"
                      Viewport="0,0,24,24"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1E1E1E">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,24,24" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#34383B">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="12,12"
                                             RadiusX="1"
                                             RadiusY="1" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <DataTemplate x:Key="ToolbarIconWithLabelTemplate">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ContentPresenter HorizontalAlignment="Center"
                                  Content="{Binding}" />
                <TextBlock Margin="0,1,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontSize="9"
                           Foreground="{StaticResource ViewerMutedTextBrush}"
                           Text="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=(AutomationProperties.Name)}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ColorSwatchWithLabelTemplate">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ContentPresenter HorizontalAlignment="Center"
                                  Content="{Binding}" />
                <TextBlock Margin="0,2,0,0"
                           HorizontalAlignment="Center"
                           FontSize="9"
                           Foreground="{StaticResource ViewerMutedTextBrush}"
                           Text="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=(AutomationProperties.Name)}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource ViewerTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <!-- 기본(Aero) 템플릿은 비활성일 때 밝은 회색 배경을 직접 칠해 다크 테마에서 튄다. 테마 색만 쓰는 템플릿으로 둔다. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ViewerPanelBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ViewerBorderBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource ViewerAccentMutedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RibbonTextButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PrimaryRibbonButtonStyle" TargetType="Button" BasedOn="{StaticResource RibbonTextButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ViewerAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerAccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ViewerOnAccentTextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ViewerAccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ViewerAccentBrush}" />
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="HeaderPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ViewerAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerAccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ViewerOnAccentTextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ViewerAccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ViewerAccentBrush}" />
                    <Setter Property="Opacity" Value="0.9" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 아이콘 버튼 아래 작은 글자 라벨. 라벨 문구는 버튼의 AutomationProperties.Name 하나로 관리한다. -->
        <Style x:Key="ToolButtonLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,1,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="ToolbarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Height" Value="48" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <!-- 문자·이미지 콘텐츠 모두에 적용된다(명시한 ContentTemplate은 UIElement 콘텐츠에도 쓰인다). 라벨을 콘텐츠에 따로 넣지 말 것. -->
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Center">
                            <ContentPresenter HorizontalAlignment="Center" Content="{Binding}" />
                            <TextBlock Style="{StaticResource ToolButtonLabelStyle}"
                                       Text="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ZoomIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="ToolGlyphButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="RibbonGroupStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="0,0,8,0" />
            <Setter Property="Background" Value="{StaticResource ViewerToolbarGroupBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>

        <Style x:Key="RibbonGroupLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource ViewerDimTextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerMutedBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
        </Style>

        <Style x:Key="ColorSwatchFillStyle" TargetType="Border">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="BorderBrush" Value="#0C0F0F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="ToolbarPropertyLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource ViewerDimTextBrush}" />
        </Style>

        <Style x:Key="ViewButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Background" Value="#20272D" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerMutedBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>

        <Style x:Key="ExplorerListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource ViewerTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ViewerAccentMutedBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ViewerAccentBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ViewerHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource ExplorerListItemStyle}">
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="{StaticResource ViewerToolbarBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ViewerMutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <ItemsPanelTemplate x:Key="IconItemsPanel">
            <WrapPanel IsItemsHost="True"
                       MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListView}}"
                       Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="DetailsItemsPanel">
            <VirtualizingStackPanel IsItemsHost="True" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="SmallIconTemplate">
            <Border Width="104"
                    Padding="6"
                    Background="Transparent">
                <StackPanel>
                    <Border Height="58"
                            Background="{StaticResource ViewerHoverBrush}"
                            BorderBrush="{StaticResource ViewerMutedBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Image Source="{Binding SmallThumbnail}"
                               Stretch="Uniform" />
                    </Border>
                    <TextBlock Margin="0,5,0,0"
                               FontSize="11"
                               Foreground="{StaticResource ViewerTextBrush}"
                               Text="{Binding FileName}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MediumIconTemplate">
            <Border Width="138"
                    Padding="7"
                    Background="Transparent">
                <StackPanel>
                    <Border Height="92"
                            Background="{StaticResource ViewerHoverBrush}"
                            BorderBrush="{StaticResource ViewerMutedBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Image Source="{Binding MediumThumbnail}"
                               Stretch="Uniform" />
                    </Border>
                    <TextBlock Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{StaticResource ViewerTextBrush}"
                               Text="{Binding FileName}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LargeIconTemplate">
            <Border Width="184"
                    Padding="8"
                    Background="Transparent">
                <StackPanel>
                    <Border Height="132"
                            Background="{StaticResource ViewerHoverBrush}"
                            BorderBrush="{StaticResource ViewerMutedBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Image Source="{Binding LargeThumbnail}"
                               Stretch="Uniform" />
                    </Border>
                    <TextBlock Margin="0,7,0,0"
                               FontSize="12"
                               Foreground="{StaticResource ViewerTextBrush}"
                               Text="{Binding FileName}"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type local:FolderTreeNode}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Width="18"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="13"
                           Foreground="{StaticResource ViewerMutedTextBrush}"
                           Text="{Binding IconGlyph}" />
                <StackPanel>
                    <TextBlock Foreground="{StaticResource ViewerTextBrush}"
                               Text="{Binding Name}" />
                    <TextBlock FontSize="10"
                               Foreground="{StaticResource ViewerDimTextBrush}"
                               Text="{Binding Detail}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource ViewerWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource ViewerPanelBackgroundBrush}"
                BorderBrush="{StaticResource ViewerBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="24"
                        Height="24"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource ViewerAccentBrush}"
                        CornerRadius="5">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Bahnschrift"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="M" />
                </Border>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentFileText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ViewerTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="10"
                               Foreground="{StaticResource ViewerDimTextBrush}"
                               Text="Mini Capture Viewer" />
                </StackPanel>
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button AutomationProperties.AutomationId="ViewerHeaderSaveButton"
                            AutomationProperties.Name="{x:Static res:Strings.Viewer_Save}"
                            Click="OnSaveClick"
                            Content="{x:Static res:Strings.Viewer_Save}"
                            ToolTip="{x:Static res:Strings.Viewer_SaveTip}"
                            Style="{StaticResource HeaderPrimaryActionButtonStyle}" />
                    <Button AutomationProperties.AutomationId="ViewerHeaderCopyImageButton"
                            AutomationProperties.Name="{x:Static res:Strings.Viewer_CopyImage}"
                            Click="OnCopyImageClick"
                            Content="{x:Static res:Strings.Viewer_CopyImage}"
                            ToolTip="{x:Static res:Strings.Viewer_CopyImageTip}"
                            Style="{StaticResource HeaderActionButtonStyle}" />
                    <Button AutomationProperties.AutomationId="ViewerHeaderCopyPathButton"
                            AutomationProperties.Name="{x:Static res:Strings.Viewer_CopyFilePath}"
                            Click="OnCopyPathClick"
                            Content="{x:Static res:Strings.Viewer_CopyPath}"
                            ToolTip="{x:Static res:Strings.Viewer_CopyFilePathTip}"
                            Style="{StaticResource HeaderActionButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource ViewerToolbarBackgroundBrush}"
                BorderBrush="{StaticResource ViewerBorderBrush}"
                BorderThickness="0,0,0,1">
            <WrapPanel Margin="10,7,0,2"
                       Orientation="Horizontal">
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource RibbonGroupLabelStyle}"
                                       Text="{x:Static res:Strings.Viewer_Group_File}" />
                            <Button AutomationProperties.AutomationId="ViewerSaveButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Save}"
                                    Click="OnSaveClick"
                                    Content="{x:Static res:Strings.Viewer_Save}"
                                    ToolTip="{x:Static res:Strings.Viewer_Save}"
                                    Style="{StaticResource PrimaryRibbonButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerOpenButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Open}"
                                    Click="OnOpenClick"
                                    Content="{x:Static res:Strings.Viewer_Open}"
                                    ToolTip="{x:Static res:Strings.Viewer_Open}"
                                    Style="{StaticResource RibbonTextButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerOpenFolderButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_OpenFolder}"
                                    Click="OnOpenFolderClick"
                                    Content="{x:Static res:Strings.Viewer_OpenFolder}"
                                    ToolTip="{x:Static res:Strings.Viewer_OpenFolder}"
                                    Style="{StaticResource RibbonTextButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerCopyImageButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_CopyImage}"
                                    Click="OnCopyImageClick"
                                    Content="{x:Static res:Strings.Viewer_CopyImage}"
                                    ToolTip="{x:Static res:Strings.Viewer_CopyImageWithMarkupTip}"
                                    Style="{StaticResource RibbonTextButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerCopyPathButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_CopyFilePath}"
                                    Click="OnCopyPathClick"
                                    Content="{x:Static res:Strings.Viewer_CopyPath}"
                                    ToolTip="{x:Static res:Strings.Viewer_CopyFilePath}"
                                    Style="{StaticResource RibbonTextButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource RibbonGroupLabelStyle}"
                                       Text="{x:Static res:Strings.Viewer_Group_View}" />
                            <Button x:Name="PreviousButton"
                                    AutomationProperties.AutomationId="ViewerPreviousButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Previous}"
                                    Click="OnPreviousClick"
                                    Content="&#xE76B;"
                                    ToolTip="{x:Static res:Strings.Viewer_PreviousTip}"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                            <Button x:Name="NextButton"
                                    AutomationProperties.AutomationId="ViewerNextButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Next}"
                                    Click="OnNextClick"
                                    Content="&#xE76C;"
                                    ToolTip="{x:Static res:Strings.Viewer_NextTip}"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerFitButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Fit}"
                                    Click="OnFitClick"
                                    Content="&#xE9A6;"
                                    ToolTip="{x:Static res:Strings.Viewer_FitTip}"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerActualSizeButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Actual}"
                                    Click="OnActualSizeClick"
                                    Content="1:1"
                                    FontFamily="Segoe UI"
                                    FontSize="11"
                                    ToolTip="{x:Static res:Strings.Viewer_ActualTip}"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerZoomOutButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_ZoomOut}"
                                    Click="OnZoomOutClick"
                                    Content="−"
                                    ToolTip="{x:Static res:Strings.Viewer_ZoomOut}"
                                    Style="{StaticResource ZoomIconButtonStyle}" />
                            <TextBox x:Name="ZoomText"
                                     Width="54"
                                     Height="28"
                                     Margin="2,0,3,0"
                                     Padding="3,0"
                                     VerticalAlignment="Center"
                                     AutomationProperties.AutomationId="ViewerZoomInput"
                                     AutomationProperties.Name="{x:Static res:Strings.Viewer_ZoomPercent}"
                                     Background="{StaticResource ViewerPanelBackgroundBrush}"
                                     BorderBrush="{StaticResource ViewerMutedBorderBrush}"
                                     Foreground="{StaticResource ViewerTextBrush}"
                                     GotKeyboardFocus="OnZoomTextGotKeyboardFocus"
                                     LostKeyboardFocus="OnZoomTextLostKeyboardFocus"
                                     PreviewKeyDown="OnZoomTextPreviewKeyDown"
                                     TextAlignment="Center"
                                     ToolTip="{x:Static res:Strings.Viewer_ZoomPercentTip}"
                                     VerticalContentAlignment="Center" />
                            <Button AutomationProperties.AutomationId="ViewerZoomInButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_ZoomIn}"
                                    Click="OnZoomInClick"
                                    Content="+"
                                    ToolTip="{x:Static res:Strings.Viewer_ZoomIn}"
                                    Style="{StaticResource ZoomIconButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerRefreshButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Refresh}"
                                    Click="OnRefreshClick"
                                    Content="&#xE72C;"
                                    ToolTip="{x:Static res:Strings.Viewer_RefreshTip}"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource ViewerToolbarGroupAltBrush}"
                            Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource RibbonGroupLabelStyle}"
                                       Text="{x:Static res:Strings.Viewer_Group_Markup}" />
                            <Button x:Name="PanToolButton"
                                    AutomationProperties.AutomationId="ViewerPanToolButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Tool_Hand}"
                                    Click="OnToolButtonClick"
                                    ToolTip="{x:Static res:Strings.Viewer_Tool_HandTip}"
                                    Style="{StaticResource ToolGlyphButtonStyle}"
                                    Tag="Pan">
                                <Image Width="22"
                                       Height="22"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="pack://application:,,,/Assets/Toolbar/pan-tool.png"
                                       Stretch="Uniform" />
                            </Button>
                            <Button x:Name="SelectToolButton"
                                    AutomationProperties.AutomationId="ViewerSelectToolButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Tool_Select}"
                                    Click="OnToolButtonClick"
                                    ToolTip="{x:Static res:Strings.Viewer_Tool_SelectTip}"
                                    Style="{StaticResource ToolGlyphButtonStyle}"
                                    Tag="Select">
                                <!-- 점선 없는 일반 마우스 화살표: 픽셀 영역(▧)과 구분되는 객체 선택·이동 도구 표시. -->
                                <Viewbox Width="22" Height="22">
                                    <Path Data="M 1,0 L 1,17 L 5.5,12.8 L 8.6,20 L 11.4,18.8 L 8.4,11.8 L 14.5,11.8 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Stroke="#FFFFFF"
                                          StrokeLineJoin="Round"
                                          StrokeThickness="1" />
                                </Viewbox>
                            </Button>
                            <Button x:Name="PenToolButton"
                                    AutomationProperties.AutomationId="ViewerPenToolButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Tool_Pen}"
                                    Click="OnToolButtonClick"
                                    Content="✎"
                                    ToolTip="{x:Static res:Strings.Viewer_Tool_PenTip}"
                                    Style="{StaticResource ToolGlyphButtonStyle}"
                                    Tag="Pen" />
                            <Button x:Name="ArrowToolButton"
                                    AutomationProperties.AutomationId="ViewerArrowToolButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Tool_Arrow}"
                                    Click="OnToolButtonClick"
                                    Content="↗"
                                    ToolTip="{x:Static res:Strings.Viewer_Tool_ArrowTip}"
                                    Style="{StaticResource ToolGlyphButtonStyle}"
                                    Tag="Arrow" />
                            <Button x:Name="RectangleToolButton"
                                    AutomationProperties.AutomationId="ViewerRectangleToolButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Tool_Rectangle}"
                                    Click="OnToolButtonClick"
                                    Content="□"
                                    ToolTip="{x:Static res:Strings.Viewer_Tool_RectangleTip}"
                                    Style="{StaticResource ToolGlyphButtonStyle}"
                                    Tag="Rectangle" />
                            <Button x:Name="EllipseToolButton"
                                    AutomationProperties.AutomationId="ViewerEllipseToolButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Tool_Ellipse}"
                                    Click="OnToolButtonClick"
                                    Content="○"
                                    ToolTip="{x:Static res:Strings.Viewer_Tool_EllipseTip}"
                                    Style="{StaticResource ToolGlyphButtonStyle}"
                                    Tag="Ellipse" />
                            <Button x:Name="TextToolButton"
                                    AutomationProperties.AutomationId="ViewerTextToolButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Tool_Text}"
                                    Click="OnToolButtonClick"
                                    Content="A"
                                    ToolTip="{x:Static res:Strings.Viewer_Tool_TextTip}"
                                    Style="{StaticResource ToolGlyphButtonStyle}"
                                    Tag="Text" />
                            <Button x:Name="MosaicToolButton"
                                    AutomationProperties.AutomationId="ViewerMosaicToolButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Tool_Mosaic}"
                                    Click="OnToolButtonClick"
                                    Content="▦"
                                    ToolTip="{x:Static res:Strings.Viewer_Tool_MosaicTip}"
                                    Style="{StaticResource ToolGlyphButtonStyle}"
                                    Tag="Mosaic" />
                            <Button x:Name="DeleteAnnotationButton"
                                    AutomationProperties.AutomationId="ViewerDeleteAnnotationButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Delete}"
                                    Click="OnDeleteAnnotationClick"
                                    Content="&#xE74D;"
                                    ToolTip="{x:Static res:Strings.Viewer_DeleteTip}"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                            <Button x:Name="UndoButton"
                                    AutomationProperties.AutomationId="ViewerUndoButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Undo}"
                                    Click="OnUndoClick"
                                    Content="&#xE7A7;"
                                    ToolTip="{x:Static res:Strings.Viewer_Undo}"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                            <Button x:Name="RedoButton"
                                    AutomationProperties.AutomationId="ViewerRedoButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Redo}"
                                    Click="OnRedoClick"
                                    Content="&#xE7A6;"
                                    ToolTip="{x:Static res:Strings.Viewer_RedoTip}"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerRotateLeftButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_RotateLeft}"
                                    Click="OnRotateLeftClick"
                                    Content="⟲"
                                    FontFamily="Segoe UI Symbol"
                                    ToolTip="{x:Static res:Strings.Viewer_RotateLeftTip}"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerRotateRightButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_RotateRight}"
                                    Click="OnRotateRightClick"
                                    Content="⟳"
                                    FontFamily="Segoe UI Symbol"
                                    ToolTip="{x:Static res:Strings.Viewer_RotateRightTip}"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource RibbonGroupLabelStyle}"
                                       Text="{x:Static res:Strings.Viewer_Group_Region}" />
                            <Button x:Name="PixelSelectToolButton"
                                    AutomationProperties.AutomationId="ViewerPixelSelectToolButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Tool_PixelRegion}"
                                    Click="OnToolButtonClick"
                                    Content="▧"
                                    ToolTip="{x:Static res:Strings.Viewer_Tool_PixelRegionTip}"
                                    Style="{StaticResource ToolGlyphButtonStyle}"
                                    Tag="PixelSelect" />
                            <Button AutomationProperties.AutomationId="ViewerCopySelectionButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Copy}"
                                    Click="OnCopySelectionClick"
                                    Content="&#xE8C8;"
                                    ToolTip="{x:Static res:Strings.Viewer_CopyRegionTip}"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerCutSelectionButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Cut}"
                                    Click="OnCutSelectionClick"
                                    Content="&#xE8C6;"
                                    ToolTip="{x:Static res:Strings.Viewer_CutRegionTip}"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerPasteSelectionButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Paste}"
                                    Click="OnPasteSelectionClick"
                                    Content="&#xE77F;"
                                    ToolTip="{x:Static res:Strings.Viewer_PasteTip}"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                            <Button x:Name="CropToolButton"
                                    AutomationProperties.AutomationId="ViewerCropToolButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Crop}"
                                    Click="OnCropToolClick"
                                    Content="&#xE7A8;"
                                    ToolTip="{x:Static res:Strings.Viewer_CropTip}"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                        </StackPanel>
                    </Border>
            </WrapPanel>
        </Border>

        <Border x:Name="ContextToolbar"
                Grid.Row="2"
                MinHeight="42"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="ViewerContextToolbar"
                AutomationProperties.Name="{x:Static res:Strings.Viewer_ToolSettings}"
                Background="{StaticResource ViewerPanelBackgroundBrush}"
                BorderBrush="{StaticResource ViewerBorderBrush}"
                BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Margin="12,5"
                            Orientation="Horizontal">
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ContextToolName"
                                       MinWidth="72"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource ViewerAccentBrush}"
                                       Text="{x:Static res:Strings.Viewer_Settings_Pen}" />
                            <StackPanel x:Name="ColorContextGroup"
                                        AutomationProperties.AutomationId="ViewerColorContextGroup"
                                        Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarPropertyLabelStyle}"
                                       Text="{x:Static res:Strings.Viewer_Color}" />
                            <ContentControl Height="28"
                                            VerticalAlignment="Center"
                                            Focusable="False">
                                <StackPanel x:Name="ColorSwatches"
                                            Orientation="Horizontal">
                                    <Button AutomationProperties.AutomationId="ViewerColorSelector"
                                            AutomationProperties.Name="{x:Static res:Strings.Viewer_Color_Red}"
                                            Click="OnColorSwatchClick"
                                            Style="{StaticResource ColorSwatchButtonStyle}"
                                            Tag="#ef4444"
                                            ToolTip="{x:Static res:Strings.Viewer_Color_Red}">
                                        <Border Background="#ef4444"
                                                Style="{StaticResource ColorSwatchFillStyle}" />
                                    </Button>
                                    <Button AutomationProperties.AutomationId="ViewerColorYellowButton"
                                            AutomationProperties.Name="{x:Static res:Strings.Viewer_Color_Yellow}"
                                            Click="OnColorSwatchClick"
                                            Style="{StaticResource ColorSwatchButtonStyle}"
                                            Tag="#facc15"
                                            ToolTip="{x:Static res:Strings.Viewer_Color_Yellow}">
                                        <Border Background="#facc15"
                                                Style="{StaticResource ColorSwatchFillStyle}" />
                                    </Button>
                                    <Button AutomationProperties.AutomationId="ViewerColorGreenButton"
                                            AutomationProperties.Name="{x:Static res:Strings.Viewer_Color_Green}"
                                            Click="OnColorSwatchClick"
                                            Style="{StaticResource ColorSwatchButtonStyle}"
                                            Tag="#12a594"
                                            ToolTip="{x:Static res:Strings.Viewer_Color_Green}">
                                        <Border Background="#12a594"
                                                Style="{StaticResource ColorSwatchFillStyle}" />
                                    </Button>
                                    <Button AutomationProperties.AutomationId="ViewerColorBlueButton"
                                            AutomationProperties.Name="{x:Static res:Strings.Viewer_Color_Blue}"
                                            Click="OnColorSwatchClick"
                                            Style="{StaticResource ColorSwatchButtonStyle}"
                                            Tag="#2563eb"
                                            ToolTip="{x:Static res:Strings.Viewer_Color_Blue}">
                                        <Border Background="#2563eb"
                                                Style="{StaticResource ColorSwatchFillStyle}" />
                                    </Button>
                                    <Button AutomationProperties.AutomationId="ViewerColorWhiteButton"
                                            AutomationProperties.Name="{x:Static res:Strings.Viewer_Color_White}"
                                            Click="OnColorSwatchClick"
                                            Style="{StaticResource ColorSwatchButtonStyle}"
                                            Tag="#ffffff"
                                            ToolTip="{x:Static res:Strings.Viewer_Color_White}">
                                        <Border Background="#ffffff"
                                                BorderBrush="#C0C7D4"
                                                BorderThickness="1"
                                                Style="{StaticResource ColorSwatchFillStyle}" />
                                    </Button>
                                    <Button AutomationProperties.AutomationId="ViewerColorBlackButton"
                                            AutomationProperties.Name="{x:Static res:Strings.Viewer_Color_Black}"
                                            Click="OnColorSwatchClick"
                                            Style="{StaticResource ColorSwatchButtonStyle}"
                                            Tag="#111827"
                                            ToolTip="{x:Static res:Strings.Viewer_Color_Black}">
                                        <Border Background="#111827"
                                                BorderBrush="#6B7280"
                                                Style="{StaticResource ColorSwatchFillStyle}" />
                                    </Button>
                                </StackPanel>
                            </ContentControl>
                            </StackPanel>
                            <StackPanel x:Name="StrokeContextGroup"
                                        AutomationProperties.AutomationId="ViewerStrokeContextGroup"
                                        Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarPropertyLabelStyle}"
                                       Margin="8,0,6,0"
                                       Text="{x:Static res:Strings.Viewer_Thickness}" />
                            <Slider x:Name="StrokeSlider"
                                    Width="86"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ViewerStrokeSlider"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_Thickness}"
                                    Minimum="1"
                                    Maximum="18"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="4"
                                    ValueChanged="OnStrokeSliderChanged" />
                            <TextBlock x:Name="StrokeText"
                                       Width="32"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource ViewerMutedTextBrush}"
                                       Text="4px" />
                            </StackPanel>
                            <StackPanel x:Name="TextContextGroup"
                                        AutomationProperties.AutomationId="ViewerTextContextGroup"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed">
                            <TextBlock Style="{StaticResource ToolbarPropertyLabelStyle}"
                                       Margin="8,0,6,0"
                                       Text="{x:Static res:Strings.Viewer_DefaultText}" />
                            <TextBox x:Name="AnnotationTextBox"
                                     Width="152"
                                     Height="30"
                                     Margin="0"
                                     Padding="8,0"
                                     AutomationProperties.AutomationId="ViewerTextInput"
                                     AutomationProperties.Name="{x:Static res:Strings.Viewer_DefaultText}"
                                     ToolTip="{x:Static res:Strings.Viewer_DefaultTextTip}"
                                     Background="{StaticResource ViewerToolbarBackgroundBrush}"
                                     BorderBrush="{StaticResource ViewerMutedBorderBrush}"
                                     Foreground="{StaticResource ViewerTextBrush}"
                                     Text="{x:Static res:Strings.Viewer_Tool_Text}"
                                     VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel x:Name="MosaicContextGroup"
                                        AutomationProperties.AutomationId="ViewerMosaicContextGroup"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed">
                            <TextBlock Style="{StaticResource ToolbarPropertyLabelStyle}"
                                       Margin="8,0,6,0"
                                       Text="{x:Static res:Strings.Viewer_Size}" />
                            <Slider x:Name="MosaicSizeSlider"
                                    Width="86"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ViewerMosaicSizeSlider"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_MosaicSize}"
                                    Minimum="6"
                                    Maximum="64"
                                    TickFrequency="2"
                                    IsSnapToTickEnabled="True"
                                    Value="14"
                                    ValueChanged="OnMosaicSizeSliderChanged" />
                            <TextBlock x:Name="MosaicSizeText"
                                       Width="32"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource ViewerMutedTextBrush}"
                                       Text="14px" />
                            <TextBlock Style="{StaticResource ToolbarPropertyLabelStyle}"
                                       Margin="8,0,6,0"
                                       Text="{x:Static res:Strings.Viewer_Type}" />
                            <Button x:Name="MosaicTypeBlockButton"
                                    AutomationProperties.AutomationId="ViewerMosaicTypeBlockButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_MosaicBlock}"
                                    Click="OnMosaicTypeButtonClick"
                                    Content="{x:Static res:Strings.Viewer_Block}"
                                    ToolTip="{x:Static res:Strings.Viewer_MosaicBlockTip}"
                                    Style="{StaticResource RibbonTextButtonStyle}"
                                    Tag="Block" />
                            <Button x:Name="MosaicTypeBlurButton"
                                    AutomationProperties.AutomationId="ViewerMosaicTypeBlurButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_MosaicBlur}"
                                    Click="OnMosaicTypeButtonClick"
                                    Content="{x:Static res:Strings.Viewer_Blur}"
                                    ToolTip="{x:Static res:Strings.Viewer_BlurTip}"
                                    Style="{StaticResource RibbonTextButtonStyle}"
                                    Tag="Blur" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FolderTreeColumn" Width="220" MinWidth="200" />
                <ColumnDefinition x:Name="FileListColumn" Width="310" MinWidth="270" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource ViewerPanelBackgroundBrush}"
                    BorderBrush="{StaticResource ViewerBorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top"
                                Margin="14,14,12,10">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ViewerTextBrush}"
                                   Text="Capture Library" />
                        <TextBlock x:Name="FolderTreeScopeText"
                                   Margin="0,1,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource ViewerDimTextBrush}"
                                   Text="{x:Static res:Strings.Folder_CaptureRoot}" />
                    </StackPanel>
                    <TreeView x:Name="FolderTree"
                              AutomationProperties.AutomationId="CaptureFolderTree"
                              BorderThickness="0"
                              Background="Transparent"
                              Foreground="{StaticResource ViewerTextBrush}"
                              FontSize="13"
                              ItemsSource="{Binding}"
                              Padding="7,0,7,10"
                              SelectedItemChanged="OnFolderTreeSelectedItemChanged">
                        <TreeView.Resources>
                            <StaticResource x:Key="{x:Static SystemColors.HighlightBrushKey}" ResourceKey="ViewerAccentMutedBrush" />
                            <StaticResource x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" ResourceKey="ViewerAccentMutedBrush" />
                            <StaticResource x:Key="{x:Static SystemColors.HighlightTextBrushKey}" ResourceKey="ViewerTextBrush" />
                            <StaticResource x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" ResourceKey="ViewerTextBrush" />
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Foreground" Value="{StaticResource ViewerTextBrush}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="4" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ViewerHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ViewerAccentMutedBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource ViewerTextBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource ViewerPanelRaisedBrush}"
                    BorderBrush="{StaticResource ViewerBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="10,10,10,4"
                            Padding="9,5"
                            Background="{StaticResource ViewerToolbarBackgroundBrush}"
                            BorderBrush="{StaticResource ViewerMutedBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AddressText"
                                       AutomationProperties.AutomationId="ViewerAddressText"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource ViewerMutedTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1"
                                    Width="26"
                                    Height="24"
                                    MinWidth="26"
                                    Padding="0"
                                    AutomationProperties.AutomationId="FileListRefreshButton"
                                    AutomationProperties.Name="{x:Static res:Strings.Viewer_RefreshFiles}"
                                    Click="OnRefreshClick"
                                    Content="&#xE72C;"
                                    FontFamily="Segoe MDL2 Assets"
                                    ToolTip="{x:Static res:Strings.Viewer_RefreshFilesTip}"
                                    Style="{StaticResource ViewButtonStyle}" />
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="1"
                               Margin="10,4">
                        <TextBlock x:Name="FileCountText"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource ViewerDimTextBrush}" />
                        <StackPanel DockPanel.Dock="Right"
                                     Orientation="Horizontal"
                                     HorizontalAlignment="Right">
                            <Button x:Name="DetailsViewButton"
                                    AutomationProperties.AutomationId="DetailsViewButton"
                                    Click="OnViewModeClick"
                                    Content="{x:Static res:Strings.Viewer_View_Details}"
                                    Style="{StaticResource ViewButtonStyle}"
                                    Tag="Details" />
                            <Button x:Name="SmallViewButton"
                                    AutomationProperties.AutomationId="SmallIconViewButton"
                                    Click="OnViewModeClick"
                                    Content="{x:Static res:Strings.Viewer_View_Small}"
                                    Style="{StaticResource ViewButtonStyle}"
                                    Tag="SmallIcons" />
                            <Button x:Name="MediumViewButton"
                                    AutomationProperties.AutomationId="MediumIconViewButton"
                                    Click="OnViewModeClick"
                                    Content="{x:Static res:Strings.Viewer_View_Medium}"
                                    Style="{StaticResource ViewButtonStyle}"
                                    Tag="MediumIcons" />
                            <Button x:Name="LargeViewButton"
                                    AutomationProperties.AutomationId="LargeIconViewButton"
                                    Click="OnViewModeClick"
                                    Content="{x:Static res:Strings.Viewer_View_Large}"
                                    Margin="0"
                                    Style="{StaticResource ViewButtonStyle}"
                                    Tag="LargeIcons" />
                        </StackPanel>
                    </DockPanel>

                    <ListView x:Name="FileList"
                              Grid.Row="2"
                              AutomationProperties.AutomationId="CaptureFileList"
                              BorderThickness="0"
                              Background="{StaticResource ViewerPanelRaisedBrush}"
                              Foreground="{StaticResource ViewerTextBrush}"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ItemsSource="{Binding}"
                              SelectionChanged="OnFileSelectionChanged"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling" />

                    <Border x:Name="CropPanel"
                            Grid.Row="3"
                            Margin="10,8,10,10"
                            Padding="10"
                            AutomationProperties.AutomationId="ViewerCropPanel"
                            AutomationProperties.Name="{x:Static res:Strings.Viewer_CropSettings}"
                            Background="{StaticResource ViewerPanelTintBrush}"
                            BorderBrush="{StaticResource ViewerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Margin="0,0,0,8"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ViewerTextBrush}"
                                       Text="{x:Static res:Strings.Viewer_Crop}" />

                            <Grid Grid.Row="1"
                                  Grid.Column="0"
                                  Margin="0,0,8,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource ViewerMutedTextBrush}"
                                           Text="{x:Static res:Strings.Viewer_Side_Left}" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="CropLeftSlider"
                                            Grid.Column="0"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="ViewerCropLeftSlider"
                                            AutomationProperties.Name="{x:Static res:Strings.Viewer_CropLeft}"
                                            IsSnapToTickEnabled="True"
                                            Maximum="1"
                                            Minimum="0"
                                            TickFrequency="1"
                                            ValueChanged="OnCropValueChanged" />
                                    <TextBox x:Name="CropLeftText"
                                             Grid.Column="1"
                                             Padding="4,0"
                                             AutomationProperties.AutomationId="ViewerCropLeftInput"
                                             AutomationProperties.Name="{x:Static res:Strings.Viewer_CropLeftPixels}"
                                             LostKeyboardFocus="OnCropTextLostKeyboardFocus"
                                             PreviewKeyDown="OnCropTextPreviewKeyDown"
                                             Tag="Left"
                                             TextAlignment="Right"
                                             VerticalContentAlignment="Center" />
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="8,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource ViewerMutedTextBrush}"
                                           Text="{x:Static res:Strings.Viewer_Side_Right}" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="CropRightSlider"
                                            Grid.Column="0"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="ViewerCropRightSlider"
                                            AutomationProperties.Name="{x:Static res:Strings.Viewer_CropRight}"
                                            IsSnapToTickEnabled="True"
                                            Maximum="1"
                                            Minimum="0"
                                            TickFrequency="1"
                                            ValueChanged="OnCropValueChanged" />
                                    <TextBox x:Name="CropRightText"
                                             Grid.Column="1"
                                             Padding="4,0"
                                             AutomationProperties.AutomationId="ViewerCropRightInput"
                                             AutomationProperties.Name="{x:Static res:Strings.Viewer_CropRightPixels}"
                                             LostKeyboardFocus="OnCropTextLostKeyboardFocus"
                                             PreviewKeyDown="OnCropTextPreviewKeyDown"
                                             Tag="Right"
                                             TextAlignment="Right"
                                             VerticalContentAlignment="Center" />
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2"
                                  Grid.Column="0"
                                  Margin="0,0,8,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource ViewerMutedTextBrush}"
                                           Text="{x:Static res:Strings.Viewer_Side_Top}" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="CropTopSlider"
                                            Grid.Column="0"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="ViewerCropTopSlider"
                                            AutomationProperties.Name="{x:Static res:Strings.Viewer_CropTop}"
                                            IsSnapToTickEnabled="True"
                                            Maximum="1"
                                            Minimum="0"
                                            TickFrequency="1"
                                            ValueChanged="OnCropValueChanged" />
                                    <TextBox x:Name="CropTopText"
                                             Grid.Column="1"
                                             Padding="4,0"
                                             AutomationProperties.AutomationId="ViewerCropTopInput"
                                             AutomationProperties.Name="{x:Static res:Strings.Viewer_CropTopPixels}"
                                             LostKeyboardFocus="OnCropTextLostKeyboardFocus"
                                             PreviewKeyDown="OnCropTextPreviewKeyDown"
                                             Tag="Top"
                                             TextAlignment="Right"
                                             VerticalContentAlignment="Center" />
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2"
                                  Grid.Column="1"
                                  Margin="8,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource ViewerMutedTextBrush}"
                                           Text="{x:Static res:Strings.Viewer_Side_Bottom}" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="CropBottomSlider"
                                            Grid.Column="0"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="ViewerCropBottomSlider"
                                            AutomationProperties.Name="{x:Static res:Strings.Viewer_CropBottom}"
                                            IsSnapToTickEnabled="True"
                                            Maximum="1"
                                            Minimum="0"
                                            TickFrequency="1"
                                            ValueChanged="OnCropValueChanged" />
                                    <TextBox x:Name="CropBottomText"
                                             Grid.Column="1"
                                             Padding="4,0"
                                             AutomationProperties.AutomationId="ViewerCropBottomInput"
                                             AutomationProperties.Name="{x:Static res:Strings.Viewer_CropBottomPixels}"
                                             LostKeyboardFocus="OnCropTextLostKeyboardFocus"
                                             PreviewKeyDown="OnCropTextPreviewKeyDown"
                                             Tag="Bottom"
                                             TextAlignment="Right"
                                             VerticalContentAlignment="Center" />
                                </Grid>
                            </Grid>

                            <StackPanel Grid.Row="3"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button AutomationProperties.AutomationId="ViewerCropCancelButton"
                                        AutomationProperties.Name="{x:Static res:Strings.Viewer_CropCancel}"
                                        Click="OnCancelCropClick"
                                        Content="{x:Static res:Strings.Common_Cancel}"
                                        Style="{StaticResource ViewButtonStyle}" />
                                <Button AutomationProperties.AutomationId="ViewerCropApplyButton"
                                        AutomationProperties.Name="{x:Static res:Strings.Viewer_CropApply}"
                                        Click="OnApplyCropClick"
                                        Content="{x:Static res:Strings.Viewer_Apply}"
                                        Style="{StaticResource PrimaryRibbonButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="2"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource ViewerBorderBrush}"
                          ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Column="3"
                  Background="{StaticResource ViewerCanvasDotBrush}">
                <ScrollViewer x:Name="ImageScrollViewer"
                              Background="Transparent"
                              CanContentScroll="False"
                              HorizontalScrollBarVisibility="Auto"
                              PreviewMouseWheel="OnImagePreviewMouseWheel"
                              ScrollChanged="OnImageScrollChanged"
                              SizeChanged="OnImageStageSizeChanged"
                              VerticalScrollBarVisibility="Auto">
                    <Grid MinWidth="{Binding ActualWidth, ElementName=ImageScrollViewer}"
                          MinHeight="{Binding ActualHeight, ElementName=ImageScrollViewer}">
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#0C0F0F"
                                BorderBrush="#3A4148"
                                BorderThickness="1">
                            <Grid x:Name="ImageSurface">
                                <Image x:Name="PreviewImage"
                                       AutomationProperties.AutomationId="ViewerPreviewImage"
                                       AutomationProperties.Name="Viewer preview image"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Stretch="Fill" />
                                <Canvas x:Name="AnnotationOverlay"
                                        AutomationProperties.AutomationId="ViewerAnnotationOverlay"
                                        AutomationProperties.Name="Viewer annotation surface"
                                        Background="Transparent"
                                        MouseLeftButtonDown="OnImageMouseLeftButtonDown"
                                        MouseLeftButtonUp="OnImageMouseLeftButtonUp"
                                        MouseMove="OnImageMouseMove" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
                <TextBlock x:Name="EmptyMessage"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{StaticResource ViewerMutedTextBrush}"
                           Text="{x:Static res:Strings.Viewer_NoImage}" />
            </Grid>
        </Grid>

        <StatusBar Grid.Row="4"
                   Background="{StaticResource ViewerPanelBackgroundBrush}"
                   BorderBrush="{StaticResource ViewerBorderBrush}"
                   BorderThickness="0,1,0,0">
            <DockPanel Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StatusBar}}">
                <StackPanel DockPanel.Dock="Right"
                            Margin="10,0,6,0"
                            Orientation="Horizontal">
                    <TextBlock x:Name="StatusMetaText"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource ViewerDimTextBrush}" />
                    <Border Style="{StaticResource StatusBadgeStyle}">
                        <TextBlock x:Name="SaveStateText"
                                   FontSize="11"
                                   Foreground="{StaticResource ViewerMutedTextBrush}"
                                   Text="{x:Static res:Strings.Viewer_Idle}" />
                    </Border>
                    <Border Style="{StaticResource StatusBadgeStyle}">
                        <TextBlock x:Name="StatusZoomText"
                                   FontSize="11"
                                   Foreground="{StaticResource ViewerMutedTextBrush}"
                                   Text="-" />
                    </Border>
                    <Slider x:Name="StatusZoomSlider"
                            Width="128"
                            Height="24"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ViewerStatusZoomSlider"
                            AutomationProperties.Name="{x:Static res:Strings.Viewer_Zoom}"
                            IsSnapToTickEnabled="False"
                            Minimum="10"
                            Maximum="800"
                            SmallChange="5"
                            LargeChange="25"
                            TickFrequency="25"
                            ToolTip="{x:Static res:Strings.Viewer_Zoom}"
                            ValueChanged="OnStatusZoomSliderChanged" />
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           AutomationProperties.AutomationId="ViewerStatusText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource ViewerMutedTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </StatusBar>
    </Grid>
</Window>
