                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                            <Button x:Name="UndoButton"
                                    AutomationProperties.AutomationId="ViewerUndoButton"
                                    AutomationProperties.Name="되돌리기"
                                    Click="OnUndoClick"
                                    Content="&#xE7A7;"
                                    ToolTip="되돌리기"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                            <Button x:Name="RedoButton"
                                    AutomationProperties.AutomationId="ViewerRedoButton"
                                    AutomationProperties.Name="다시"
                                    Click="OnRedoClick"
                                    Content="&#xE7A6;"
                                    ToolTip="다시 적용"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerRotateLeftButton"
                                    AutomationProperties.Name="좌회전"
                                    Click="OnRotateLeftClick"
                                    Content="⟲"
                                    FontFamily="Segoe UI Symbol"
                                    ToolTip="왼쪽 회전"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerRotateRightButton"
                                    AutomationProperties.Name="우회전"
                                    Click="OnRotateRightClick"
                                    Content="⟳"
                                    FontFamily="Segoe UI Symbol"
                                    ToolTip="오른쪽 회전"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource RibbonGroupLabelStyle}"
                                       Text="영역" />
                            <Button x:Name="PixelSelectToolButton"
                                    AutomationProperties.AutomationId="ViewerPixelSelectToolButton"
                                    AutomationProperties.Name="영역 선택"
                                    Click="OnToolButtonClick"
                                    Content="▧"
                                    ToolTip="영역 선택"
                                    Style="{StaticResource ToolGlyphButtonStyle}"
                                    Tag="PixelSelect" />
                            <Button AutomationProperties.AutomationId="ViewerCopySelectionButton"
                                    AutomationProperties.Name="선택 영역 복사"
                                    Click="OnCopySelectionClick"
                                    Content="복사"
                                    ToolTip="선택 영역 복사 (Ctrl+C)"
                                    Style="{StaticResource RibbonTextButtonStyle}" />
                            <Button AutomationProperties.AutomationId="ViewerCutSelectionButton"
                                    AutomationProperties.Name="선택 영역 잘라내기"
