                                    AutomationProperties.Name="선택 영역 붙여넣기"
                                    Click="OnPasteSelectionClick"
                                    Content="붙여넣기"
                                    ToolTip="선택 영역 위치에 붙여넣기 (Ctrl+V)"
                                    Style="{StaticResource RibbonTextButtonStyle}" />
                            <Button x:Name="CropToolButton"
                                    AutomationProperties.AutomationId="ViewerCropToolButton"
                                    AutomationProperties.Name="이미지 자르기"
                                    Click="OnCropToolClick"
                                    Content="&#xE7A8;"
                                    ToolTip="이미지 위·아래·양옆 자르기"
                                    Style="{StaticResource ToolbarIconButtonStyle}" />
                        </StackPanel>
                    </Border>
            </WrapPanel>
        </Border>

        <Border x:Name="ContextToolbar"
                Grid.Row="2"
                MinHeight="42"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="ViewerContextToolbar"
                AutomationProperties.Name="선택 도구 설정"
                Background="#FAFBFB"
                BorderBrush="{StaticResource ViewerBorderBrush}"
                BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Margin="12,5"
                            Orientation="Horizontal">
                    <Border Style="{StaticResource RibbonGroupStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ContextToolName"
                                       MinWidth="72"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource ViewerAccentBrush}"
                                       Text="펜 설정" />
                            <StackPanel x:Name="ColorContextGroup"
                                        AutomationProperties.AutomationId="ViewerColorContextGroup"
                                        Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarPropertyLabelStyle}"
                                       Text="색상" />
                            <ContentControl Height="28"
                                            VerticalAlignment="Center"
                                            Focusable="False">
                                <StackPanel x:Name="ColorSwatches"
                                            Orientation="Horizontal">
                                    <Button AutomationProperties.AutomationId="ViewerColorSelector"
                                            AutomationProperties.Name="빨강"
                                            Click="OnColorSwatchClick"
                                            Style="{StaticResource ColorSwatchButtonStyle}"
                                            Tag="#ef4444"
                                            ToolTip="빨강">
                                        <Border Background="#ef4444"
                                                Style="{StaticResource ColorSwatchFillStyle}" />
                                    </Button>
                                    <Button AutomationProperties.AutomationId="ViewerColorYellowButton"
                                            AutomationProperties.Name="노랑"
                                            Click="OnColorSwatchClick"
                                            Style="{StaticResource ColorSwatchButtonStyle}"
                                            Tag="#facc15"
                                            ToolTip="노랑">
                                        <Border Background="#facc15"
                                                Style="{StaticResource ColorSwatchFillStyle}" />
                                    </Button>
                                    <Button AutomationProperties.AutomationId="ViewerColorGreenButton"
                                            AutomationProperties.Name="초록"
                                            Click="OnColorSwatchClick"
                                            Style="{StaticResource ColorSwatchButtonStyle}"
                                            Tag="#12a594"
                                            ToolTip="초록">
                                        <Border Background="#12a594"
                                                Style="{StaticResource ColorSwatchFillStyle}" />
                                    </Button>
                                    <Button AutomationProperties.AutomationId="ViewerColorBlueButton"
                                            AutomationProperties.Name="파랑"
                                            Click="OnColorSwatchClick"
                                            Style="{StaticResource ColorSwatchButtonStyle}"
                                            Tag="#2563eb"
                                            ToolTip="파랑">
                                        <Border Background="#2563eb"
                                                Style="{StaticResource ColorSwatchFillStyle}" />
                                    </Button>
                                    <Button AutomationProperties.AutomationId="ViewerColorWhiteButton"
                                            AutomationProperties.Name="흰색"
                                            Click="OnColorSwatchClick"
                                            Style="{StaticResource ColorSwatchButtonStyle}"
                                            Tag="#ffffff"
                                            ToolTip="흰색">
                                        <Border Background="#ffffff"
                                                BorderBrush="#C0C7D4"
                                                BorderThickness="1"
                                                Style="{StaticResource ColorSwatchFillStyle}" />
                                    </Button>
                                    <Button AutomationProperties.AutomationId="ViewerColorBlackButton"
                                            AutomationProperties.Name="검정"
                                            Click="OnColorSwatchClick"
                                            Style="{StaticResource ColorSwatchButtonStyle}"
                                            Tag="#111827"
                                            ToolTip="검정">
                                        <Border Background="#111827"
                                                BorderBrush="#6B7280"
                                                Style="{StaticResource ColorSwatchFillStyle}" />
                                    </Button>
                                </StackPanel>
                            </ContentControl>
                            </StackPanel>
                            <StackPanel x:Name="StrokeContextGroup"
                                        AutomationProperties.AutomationId="ViewerStrokeContextGroup"
                                        Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolbarPropertyLabelStyle}"
                                       Margin="8,0,6,0"
                                       Text="두께" />
                            <Slider x:Name="StrokeSlider"
                                    Width="86"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ViewerStrokeSlider"
                                    AutomationProperties.Name="두께"
                                    Minimum="1"
                                    Maximum="18"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="4"
                                    ValueChanged="OnStrokeSliderChanged" />
                            <TextBlock x:Name="StrokeText"
                                       Width="32"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource ViewerMutedTextBrush}"
                                       Text="4px" />
                            </StackPanel>
                            <StackPanel x:Name="TextContextGroup"
                                        AutomationProperties.AutomationId="ViewerTextContextGroup"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed">
                            <TextBlock Style="{StaticResource ToolbarPropertyLabelStyle}"
                                       Margin="8,0,6,0"
                                       Text="텍스트" />
                            <TextBox x:Name="AnnotationTextBox"
                                     Width="152"
                                     Height="30"
                                     Margin="0"
                                     Padding="8,0"
                                     AutomationProperties.AutomationId="ViewerTextInput"
                                     AutomationProperties.Name="텍스트"
                                     Background="#F1F4F4"
                                     BorderBrush="{StaticResource ViewerMutedBorderBrush}"
                                     Foreground="{StaticResource ViewerTextBrush}"
                                     Text="텍스트"
                                     VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel x:Name="MosaicContextGroup"
                                        AutomationProperties.AutomationId="ViewerMosaicContextGroup"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed">
                            <TextBlock Style="{StaticResource ToolbarPropertyLabelStyle}"
                                       Margin="8,0,6,0"
                                       Text="크기" />
                            <Slider x:Name="MosaicSizeSlider"
                                    Width="86"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ViewerMosaicSizeSlider"
                                    AutomationProperties.Name="모자이크 크기"
                                    Minimum="6"
                                    Maximum="64"
                                    TickFrequency="2"
                                    IsSnapToTickEnabled="True"
                                    Value="14"
                                    ValueChanged="OnMosaicSizeSliderChanged" />
                            <TextBlock x:Name="MosaicSizeText"
                                       Width="32"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource ViewerMutedTextBrush}"
                                       Text="14px" />
                            <TextBlock Style="{StaticResource ToolbarPropertyLabelStyle}"
                                       Margin="8,0,6,0"
                                       Text="종류" />
                            <Button x:Name="MosaicTypeBlockButton"
                                    AutomationProperties.AutomationId="ViewerMosaicTypeBlockButton"
                                    AutomationProperties.Name="블록 모자이크"
                                    Click="OnMosaicTypeButtonClick"
                                    Content="블록"
                                    ToolTip="사각형 블록 모자이크"
                                    Style="{StaticResource RibbonTextButtonStyle}"
                                    Tag="Block" />
                            <Button x:Name="MosaicTypeBlurButton"
                                    AutomationProperties.AutomationId="ViewerMosaicTypeBlurButton"
                                    AutomationProperties.Name="흐림 모자이크"
                                    Click="OnMosaicTypeButtonClick"
                                    Content="흐림"
                                    ToolTip="가우시안 흐림"
                                    Style="{StaticResource RibbonTextButtonStyle}"
                                    Tag="Blur" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FolderTreeColumn" Width="220" MinWidth="200" />
                <ColumnDefinition x:Name="FileListColumn" Width="310" MinWidth="270" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource ViewerPanelBackgroundBrush}"
                    BorderBrush="{StaticResource ViewerBorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top"
                                Margin="14,14,12,10">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ViewerTextBrush}"
                                   Text="Capture Library" />
                        <TextBlock x:Name="FolderTreeScopeText"
                                   Margin="0,1,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource ViewerDimTextBrush}"
                                   Text="캡처 루트" />
                    </StackPanel>
                    <TreeView x:Name="FolderTree"
                              AutomationProperties.AutomationId="CaptureFolderTree"
                              BorderThickness="0"
                              Background="Transparent"
                              Foreground="{StaticResource ViewerTextBrush}"
                              FontSize="13"
                              ItemsSource="{Binding}"
                              Padding="7,0,7,10"
                              SelectedItemChanged="OnFolderTreeSelectedItemChanged">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#D8EEEB" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#D8EEEB" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#293638" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#293638" />
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Foreground" Value="{StaticResource ViewerTextBrush}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="4" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E8EEEE" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ViewerAccentMutedBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource ViewerTextBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource ViewerPanelRaisedBrush}"
                    BorderBrush="{StaticResource ViewerBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="10,10,10,4"
                            Padding="9,5"
                            Background="#F1F4F4"
                            BorderBrush="{StaticResource ViewerMutedBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="AddressText"
                                       AutomationProperties.AutomationId="ViewerAddressText"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource ViewerMutedTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1"
                                    Width="26"
                                    Height="24"
                                    MinWidth="26"
                                    Padding="0"
                                    AutomationProperties.AutomationId="FileListRefreshButton"
                                    AutomationProperties.Name="파일 목록 새로고침"
                                    Click="OnRefreshClick"
                                    Content="&#xE72C;"
                                    FontFamily="Segoe MDL2 Assets"
                                    ToolTip="현재 폴더 파일 목록 새로고침 (F5)"
                                    Style="{StaticResource ViewButtonStyle}" />
                        </Grid>
                    </Border>

                    <DockPanel Grid.Row="1"
                               Margin="10,4">
                        <TextBlock x:Name="FileCountText"
                                   DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource ViewerDimTextBrush}" />
                        <StackPanel DockPanel.Dock="Right"
                                     Orientation="Horizontal"
                                     HorizontalAlignment="Right">
                            <Button x:Name="DetailsViewButton"
                                    AutomationProperties.AutomationId="DetailsViewButton"
                                    Click="OnViewModeClick"
                                    Content="자세히"
                                    Style="{StaticResource ViewButtonStyle}"
                                    Tag="Details" />
                            <Button x:Name="SmallViewButton"
                                    AutomationProperties.AutomationId="SmallIconViewButton"
                                    Click="OnViewModeClick"
                                    Content="작게"
                                    Style="{StaticResource ViewButtonStyle}"
                                    Tag="SmallIcons" />
                            <Button x:Name="MediumViewButton"
                                    AutomationProperties.AutomationId="MediumIconViewButton"
                                    Click="OnViewModeClick"
                                    Content="중간"
                                    Style="{StaticResource ViewButtonStyle}"
                                    Tag="MediumIcons" />
                            <Button x:Name="LargeViewButton"
                                    AutomationProperties.AutomationId="LargeIconViewButton"
                                    Click="OnViewModeClick"
                                    Content="크게"
                                    Margin="0"
                                    Style="{StaticResource ViewButtonStyle}"
                                    Tag="LargeIcons" />
                        </StackPanel>
                    </DockPanel>

                    <ListView x:Name="FileList"
                              Grid.Row="2"
                              AutomationProperties.AutomationId="CaptureFileList"
                              BorderThickness="0"
                              Background="{StaticResource ViewerPanelRaisedBrush}"
                              Foreground="{StaticResource ViewerTextBrush}"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ItemsSource="{Binding}"
                              SelectionChanged="OnFileSelectionChanged"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling" />

                    <Border x:Name="CropPanel"
                            Grid.Row="3"
                            Margin="10,8,10,10"
                            Padding="10"
                            AutomationProperties.AutomationId="ViewerCropPanel"
                            AutomationProperties.Name="자르기 설정"
                            Background="#EEF4F3"
                            BorderBrush="{StaticResource ViewerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Margin="0,0,0,8"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ViewerTextBrush}"
                                       Text="자르기" />

                            <Grid Grid.Row="1"
                                  Grid.Column="0"
                                  Margin="0,0,8,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource ViewerMutedTextBrush}"
                                           Text="왼쪽" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="CropLeftSlider"
                                            Grid.Column="0"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="ViewerCropLeftSlider"
                                            AutomationProperties.Name="왼쪽 자르기"
                                            IsSnapToTickEnabled="True"
                                            Maximum="1"
                                            Minimum="0"
                                            TickFrequency="1"
                                            ValueChanged="OnCropValueChanged" />
                                    <TextBox x:Name="CropLeftText"
                                             Grid.Column="1"
                                             Padding="4,0"
                                             AutomationProperties.AutomationId="ViewerCropLeftInput"
                                             AutomationProperties.Name="왼쪽 자르기 픽셀"
                                             LostKeyboardFocus="OnCropTextLostKeyboardFocus"
                                             PreviewKeyDown="OnCropTextPreviewKeyDown"
                                             Tag="Left"
                                             TextAlignment="Right"
                                             VerticalContentAlignment="Center" />
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="1"
                                  Grid.Column="1"
                                  Margin="8,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource ViewerMutedTextBrush}"
                                           Text="오른쪽" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="CropRightSlider"
                                            Grid.Column="0"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="ViewerCropRightSlider"
                                            AutomationProperties.Name="오른쪽 자르기"
                                            IsSnapToTickEnabled="True"
                                            Maximum="1"
                                            Minimum="0"
                                            TickFrequency="1"
                                            ValueChanged="OnCropValueChanged" />
                                    <TextBox x:Name="CropRightText"
                                             Grid.Column="1"
                                             Padding="4,0"
                                             AutomationProperties.AutomationId="ViewerCropRightInput"
                                             AutomationProperties.Name="오른쪽 자르기 픽셀"
                                             LostKeyboardFocus="OnCropTextLostKeyboardFocus"
                                             PreviewKeyDown="OnCropTextPreviewKeyDown"
                                             Tag="Right"
                                             TextAlignment="Right"
                                             VerticalContentAlignment="Center" />
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2"
                                  Grid.Column="0"
                                  Margin="0,0,8,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource ViewerMutedTextBrush}"
                                           Text="위" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="CropTopSlider"
                                            Grid.Column="0"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="ViewerCropTopSlider"
                                            AutomationProperties.Name="위 자르기"
                                            IsSnapToTickEnabled="True"
                                            Maximum="1"
                                            Minimum="0"
                                            TickFrequency="1"
                                            ValueChanged="OnCropValueChanged" />
                                    <TextBox x:Name="CropTopText"
                                             Grid.Column="1"
                                             Padding="4,0"
                                             AutomationProperties.AutomationId="ViewerCropTopInput"
                                             AutomationProperties.Name="위 자르기 픽셀"
                                             LostKeyboardFocus="OnCropTextLostKeyboardFocus"
                                             PreviewKeyDown="OnCropTextPreviewKeyDown"
                                             Tag="Top"
                                             TextAlignment="Right"
                                             VerticalContentAlignment="Center" />
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2"
                                  Grid.Column="1"
                                  Margin="8,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="11"
                                           Foreground="{StaticResource ViewerMutedTextBrush}"
                                           Text="아래" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="CropBottomSlider"
                                            Grid.Column="0"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="ViewerCropBottomSlider"
                                            AutomationProperties.Name="아래 자르기"
                                            IsSnapToTickEnabled="True"
                                            Maximum="1"
                                            Minimum="0"
                                            TickFrequency="1"
                                            ValueChanged="OnCropValueChanged" />
                                    <TextBox x:Name="CropBottomText"
                                             Grid.Column="1"
                                             Padding="4,0"
                                             AutomationProperties.AutomationId="ViewerCropBottomInput"
                                             AutomationProperties.Name="아래 자르기 픽셀"
                                             LostKeyboardFocus="OnCropTextLostKeyboardFocus"
                                             PreviewKeyDown="OnCropTextPreviewKeyDown"
                                             Tag="Bottom"
                                             TextAlignment="Right"
                                             VerticalContentAlignment="Center" />
                                </Grid>
                            </Grid>

                            <StackPanel Grid.Row="3"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button AutomationProperties.AutomationId="ViewerCropCancelButton"
                                        AutomationProperties.Name="자르기 취소"
                                        Click="OnCancelCropClick"
                                        Content="취소"
                                        Style="{StaticResource ViewButtonStyle}" />
                                <Button AutomationProperties.AutomationId="ViewerCropApplyButton"
                                        AutomationProperties.Name="자르기 적용"
                                        Click="OnApplyCropClick"
                                        Content="적용"
                                        Style="{StaticResource PrimaryRibbonButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="2"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource ViewerBorderBrush}"
                          ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Column="3"
                  Background="{StaticResource ViewerCanvasDotBrush}">
                <ScrollViewer x:Name="ImageScrollViewer"
                              Background="Transparent"
                              CanContentScroll="False"
                              HorizontalScrollBarVisibility="Auto"
                              PreviewMouseWheel="OnImagePreviewMouseWheel"
                              ScrollChanged="OnImageScrollChanged"
                              SizeChanged="OnImageStageSizeChanged"
                              VerticalScrollBarVisibility="Auto">
                    <Grid MinWidth="{Binding ActualWidth, ElementName=ImageScrollViewer}"
                          MinHeight="{Binding ActualHeight, ElementName=ImageScrollViewer}">
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#0C0F0F"
                                BorderBrush="#3A4148"
                                BorderThickness="1">
                            <Grid x:Name="ImageSurface">
                                <Image x:Name="PreviewImage"
                                       AutomationProperties.AutomationId="ViewerPreviewImage"
                                       AutomationProperties.Name="Viewer preview image"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Stretch="Fill" />
                                <Canvas x:Name="AnnotationOverlay"
                                        AutomationProperties.AutomationId="ViewerAnnotationOverlay"
                                        AutomationProperties.Name="Viewer annotation surface"
                                        Background="Transparent"
                                        MouseLeftButtonDown="OnImageMouseLeftButtonDown"
                                        MouseLeftButtonUp="OnImageMouseLeftButtonUp"
                                        MouseMove="OnImageMouseMove" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
                <TextBlock x:Name="EmptyMessage"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{StaticResource ViewerMutedTextBrush}"
                           Text="표시할 이미지가 없습니다." />
            </Grid>
        </Grid>

        <StatusBar Grid.Row="4"
                   Background="#FAFBFB"
                   BorderBrush="{StaticResource ViewerBorderBrush}"
                   BorderThickness="0,1,0,0">
            <DockPanel Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StatusBar}}">
                <StackPanel DockPanel.Dock="Right"
                            Margin="10,0,6,0"
                            Orientation="Horizontal">
                    <TextBlock x:Name="StatusMetaText"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource ViewerDimTextBrush}" />
                    <Border Style="{StaticResource StatusBadgeStyle}">
                        <TextBlock x:Name="SaveStateText"
                                   FontSize="11"
                                   Foreground="{StaticResource ViewerMutedTextBrush}"
                                   Text="대기" />
                    </Border>
                    <Border Style="{StaticResource StatusBadgeStyle}">
                        <TextBlock x:Name="StatusZoomText"
                                   FontSize="11"
                                   Foreground="{StaticResource ViewerMutedTextBrush}"
                                   Text="-" />
                    </Border>
                    <Slider x:Name="StatusZoomSlider"
                            Width="128"
                            Height="24"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ViewerStatusZoomSlider"
                            AutomationProperties.Name="확대/축소"
                            IsSnapToTickEnabled="False"
                            Minimum="10"
                            Maximum="800"
                            SmallChange="5"
                            LargeChange="25"
                            TickFrequency="25"
                            ToolTip="확대/축소"
                            ValueChanged="OnStatusZoomSliderChanged" />
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           AutomationProperties.AutomationId="ViewerStatusText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource ViewerMutedTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </StatusBar>
    </Grid>
</Window>
